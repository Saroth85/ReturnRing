# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=returnring
POSTGRES_PASSWORD=change-me
POSTGRES_DB=returnring
DATABASE_URL=postgresql://returnring:change-me@postgres:5432/returnring

# Runtime switches for the laptop (see CLAUDE.md). The gpu and demo profiles override them in
# infra/compose.gpu.yml (DEVICE=gpu, LLM_MODE=vllm) and infra/compose.demo.yml (DEMO_MODE=cached).
DEVICE=cpu
LLM_MODE=mock
# AMD shared inference: set LLM_MODE=tokenfactory and RADEON_API_KEY below.
# The adapter fixes the catalog model to Gemma-4-31B-IT; GEMMA_MODEL is local vLLM only.
RADEON_API_KEY=
DEMO_MODE=live
SEED=42

# User and group the pipeline job writes data/ as: the owner of the checkout (`id -u`, `id -g`;
# 0 for a clone made as root, as on the droplet). The Makefile sets both from the shell, which
# wins over this file; these values apply to a bare `docker compose` call.
HOST_UID=1000
HOST_GID=1000

# vLLM on the MI300X (gpu profile only). Generate the key on the droplet: openssl rand -hex 24
VLLM_API_KEY=change-me
VLLM_BASE_URL=http://vllm:8001/v1
GEMMA_MODEL=google/gemma-4-31B-it
# Hugging Face commit of GEMMA_MODEL (13 Oct 2026), so a later session from the snapshot never
# downloads different weights. Plan B model google/gemma-4-26B-A4B-it: change both lines together,
# revision 4d7ae4984b7db7de8f8457170b3f1a419ee76d52.
GEMMA_REVISION=842da3794eaa0b77d5f08bae87a17459d91ff475
# Not needed: google/gemma-4-31B-it and gemma-4-26B-A4B-it are not gated on Hugging Face.
HF_TOKEN=

# Images pinned by tag and digest (checked against registry-1.docker.io on 13 Oct 2026).
# vLLM 0.31.0 on ROCm 7.2.3 (Ubuntu 22.04, ENTRYPOINT "vllm serve").
VLLM_IMAGE=vllm/vllm-openai-rocm:v0.31.0@sha256:749f6f3f944f12af49966ac523c1f8573e4b229594b541954bd5f879b4496b1f
# DGL 2.4.0 on ROCm 7.0.0, PyTorch 2.8.0, Python 3.12 (newest DGL build AMD publishes; no :latest tag).
DGL_IMAGE=rocm/dgl:dgl-2.4.0.amd0_rocm7.0.0_ubuntu24.04_py3.12_pytorch_2.8.0@sha256:943698ddf54c22a7bcad2e5b4ff467752e29e4ba6d0c926789ae7b242cbd92dd
# ROCm 7.2.3 base for trainer-gbm and telemetry, as in the AMD Finance (amd_xgboost) install docs.
# Never :latest (it is ROCm 10.x, which amd_xgboost does not support).
ROCM_BASE_IMAGE=rocm/dev-ubuntu-24.04:7.2.3-complete@sha256:ec1b59bf75ec1122e7a091c0be82301ba12458b038499ef96a5c115876bd78d2
# AMD index for amd_xgboost 3.2.0 built for ROCm 7.2.3. Used with --index-url only, never as an
# extra index; the wheel hash is pinned in infra/docker/requirements-gbm-amd.txt.
AMD_PYPI_INDEX_URL=https://pypi.amd.com/rocm-7.2.3/simple

# Serving snapshot and benchmark results (ADR-16): compose mounts serving/ (demo-cache/serving/
# in the cached demo) and bench/results/ read-only and sets SERVING_DIR and BENCHMARKS_DIR itself.
# DEMO_CLOCK=on: the API's 'now' is the snapshot instant plus the time since the reset, the
# instant of the reset's decisions (off: the wall clock).
DEMO_CLOCK=on
# PUBLIC_READ_ONLY=true makes the API refuse writes (spec 11, public read-only views). Leave it
# unset for the defaults: false on the laptop and the GPU droplet, true in the cached demo.
# PUBLIC_READ_ONLY=
# Model calls in flight at once (reset, batch, API) and the vLLM timeout in seconds; unset: 32, 20.
# LLM_CONCURRENCY=
# VLLM_TIMEOUT_S=

# Public server (make gpu-up, make demo-up; infra/compose.public.yml): HTTPS by Caddy on
# PUBLIC_HOST, e.g. PUBLIC_HOST=203-0-113-10.sslip.io for the IP 203.0.113.10 (no domain needed).
# Left empty here on purpose: a public start without a host stops with an error. Basic auth on
# /api/telemetry and, unless PUBLIC_READ_ONLY=true, every write, for the user admin (fixed in
# infra/Caddyfile, which refuses any other user name before hashing). Put the bcrypt hash of
# `make admin-password` (cost 10) between single quotes: ADMIN_PASSWORD_HASH='$2a$10$...'. On
# the laptop (make dev-up, make demo-local) the proxy listens on 127.0.0.1:8080 only, asks for
# nothing and needs neither value.
PUBLIC_HOST=
ADMIN_PASSWORD_HASH=
