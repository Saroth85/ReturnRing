# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=returnring
POSTGRES_PASSWORD=change-me
POSTGRES_DB=returnring
DATABASE_URL=postgresql://returnring:change-me@postgres:5432/returnring

# Runtime switches (see CLAUDE.md)
DEVICE=cpu
LLM_MODE=mock
DEMO_MODE=live
SEED=42

# vLLM on the MI300X (gpu profile only)
VLLM_API_KEY=change-me
VLLM_BASE_URL=http://vllm:8001/v1
GEMMA_MODEL=google/gemma-4-31B-it
HF_TOKEN=

# Images: pin by digest after the Monday spikes (docs/spike-results.md)
VLLM_IMAGE=vllm/vllm-openai-rocm:latest
DGL_IMAGE=rocm/dgl:latest
ROCM_BASE_IMAGE=rocm/dev-ubuntu-24.04:latest
# Index URL for amd_xgboost, copied from the ROCm XGBoost install docs
AMD_PYPI_INDEX_URL=

# Public demo
PUBLIC_HOST=localhost
