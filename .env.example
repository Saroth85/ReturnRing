# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=returnring
POSTGRES_PASSWORD=change-me
POSTGRES_DB=returnring
DATABASE_URL=postgresql://returnring:change-me@postgres:5432/returnring

# Runtime switches for the laptop (see CLAUDE.md). The cached demo overrides them in
# infra/compose.demo.yml (DEMO_MODE=cached, LLM_MODE=mock, DEVICE=cpu).
DEVICE=cpu
LLM_MODE=mock
# AMD shared inference (optional): set LLM_MODE=tokenfactory and RADEON_API_KEY below. Synthetic
# demo cases only (CLAUDE.md rule 2); the reset still drafts with the mock (ADR-18).
# The adapter fixes the catalog model to Gemma-4-31B-IT; GEMMA_MODEL is local vLLM only.
RADEON_API_KEY=
DEMO_MODE=live
SEED=42

# User and group the pipeline job writes data/ as: the owner of the checkout (`id -u`, `id -g`;
# 0 for a clone made as root). The Makefile sets both from the shell, which wins over this file;
# these values apply to a bare `docker compose` call.
HOST_UID=1000
HOST_GID=1000

# Local vLLM (LLM_MODE=vllm, optional, never run with Gemma for this submission): an
# OpenAI-compatible server at a local or private address. GEMMA_MODEL is the model it serves.
VLLM_API_KEY=change-me
VLLM_BASE_URL=http://vllm:8001/v1
GEMMA_MODEL=google/gemma-4-31B-it

# Serving snapshot and benchmark results (ADR-16): compose mounts serving/ (demo-cache/serving/
# in the cached demo) and bench/results/ read-only and sets SERVING_DIR and BENCHMARKS_DIR itself.
# DEMO_CLOCK=on: the API's 'now' is the snapshot instant plus the time since the reset, the
# instant of the reset's decisions (off: the wall clock).
DEMO_CLOCK=on
# PUBLIC_READ_ONLY=true makes the API refuse writes (spec 11, public read-only views). Leave it
# unset for the defaults: false on the laptop, true in the cached demo.
# PUBLIC_READ_ONLY=
# The proxies in front of the API that write X-Forwarded-For (Caddy here, a platform edge on
# Railway): the rate limits key a client on the entry the nearest one wrote. 0 if uvicorn is
# reached directly (ADR-18, amendment).
# TRUSTED_PROXY_HOPS=1
# Model calls in flight at once (reset, batch, API) and the model timeout in seconds; unset: 32
# and 20, or 1 and 90 with LLM_MODE=tokenfactory (apps/api/settings.py).
# LLM_CONCURRENCY=
# VLLM_TIMEOUT_S=

# Optional self-hosted public server (make demo-up; infra/compose.public.yml): HTTPS by Caddy on
# PUBLIC_HOST, e.g. PUBLIC_HOST=203-0-113-10.sslip.io for the IP 203.0.113.10 (no domain needed).
# Left empty here on purpose: a public start without a host stops with an error. Basic auth on
# /api/telemetry and, unless PUBLIC_READ_ONLY=true, every write, for the user admin (fixed in
# infra/Caddyfile, which refuses any other user name before hashing). Put the bcrypt hash of
# `make admin-password` (cost 10) between single quotes: ADMIN_PASSWORD_HASH='$2a$10$...'. On
# the laptop (make dev-up, make demo-local) the proxy listens on 127.0.0.1:8080 only, asks for
# nothing and needs neither value.
PUBLIC_HOST=
ADMIN_PASSWORD_HASH=
