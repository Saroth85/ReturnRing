# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=returnring
POSTGRES_PASSWORD=change-me
POSTGRES_DB=returnring
DATABASE_URL=postgresql://returnring:change-me@postgres:5432/returnring

# Runtime switches for the laptop (see CLAUDE.md). The gpu and demo profiles override them in
# infra/compose.gpu.yml (DEVICE=gpu, LLM_MODE=vllm) and infra/compose.demo.yml (DEMO_MODE=cached).
DEVICE=cpu
LLM_MODE=mock
DEMO_MODE=live
SEED=42

# vLLM on the MI300X (gpu profile only). Generate the key on the droplet: openssl rand -hex 24
VLLM_API_KEY=change-me
VLLM_BASE_URL=http://vllm:8001/v1
GEMMA_MODEL=google/gemma-4-31B-it
# Hugging Face commit of GEMMA_MODEL (13 Oct 2026), so a later session from the snapshot never
# downloads different weights. Plan B model google/gemma-4-26B-A4B-it: change both lines together,
# revision 4d7ae4984b7db7de8f8457170b3f1a419ee76d52.
GEMMA_REVISION=842da3794eaa0b77d5f08bae87a17459d91ff475
# Not needed: google/gemma-4-31B-it and gemma-4-26B-A4B-it are not gated on Hugging Face.
HF_TOKEN=

# Images pinned by tag and digest (checked against registry-1.docker.io on 13 Oct 2026).
# vLLM 0.31.0 on ROCm 7.2.3 (Ubuntu 22.04, ENTRYPOINT "vllm serve").
VLLM_IMAGE=vllm/vllm-openai-rocm:v0.31.0@sha256:749f6f3f944f12af49966ac523c1f8573e4b229594b541954bd5f879b4496b1f
# DGL 2.4.0 on ROCm 7.0.0, PyTorch 2.8.0, Python 3.12 (newest DGL build AMD publishes; no :latest tag).
DGL_IMAGE=rocm/dgl:dgl-2.4.0.amd0_rocm7.0.0_ubuntu24.04_py3.12_pytorch_2.8.0@sha256:943698ddf54c22a7bcad2e5b4ff467752e29e4ba6d0c926789ae7b242cbd92dd
# ROCm 7.2.3 base for trainer-gbm and telemetry, as in the AMD Finance (amd_xgboost) install docs.
# Never :latest (it is ROCm 10.x, which amd_xgboost does not support).
ROCM_BASE_IMAGE=rocm/dev-ubuntu-24.04:7.2.3-complete@sha256:ec1b59bf75ec1122e7a091c0be82301ba12458b038499ef96a5c115876bd78d2
# AMD index for amd_xgboost 3.2.0 built for ROCm 7.2.3. Used with --index-url only, never as an
# extra index; the wheel hash is pinned in infra/docker/requirements-gbm-amd.txt.
AMD_PYPI_INDEX_URL=https://pypi.amd.com/rocm-7.2.3/simple

# Public demo
PUBLIC_HOST=localhost
