{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "AnswerEvent": {
      "additionalProperties": false,
      "description": "The final answer, with the evidence consulted and the evidence missing side by side.",
      "properties": {
        "type": {
          "const": "answer",
          "title": "Type",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_consulted": {
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "title": "Evidence Consulted",
          "type": "array"
        },
        "evidence_missing": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Missing",
          "type": "array"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "type",
        "seq",
        "text",
        "evidence_consulted",
        "evidence_missing",
        "refs"
      ],
      "title": "AnswerEvent",
      "type": "object"
    },
    "DoneEvent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "done",
          "title": "Type",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "steps_used": {
          "maximum": 5,
          "minimum": 0,
          "title": "Steps Used",
          "type": "integer"
        },
        "generation": {
          "$ref": "#/$defs/GenerationInfo"
        }
      },
      "required": [
        "type",
        "seq",
        "steps_used",
        "generation"
      ],
      "title": "DoneEvent",
      "type": "object"
    },
    "EntityRef": {
      "additionalProperties": false,
      "description": "A link target in the UI (US-701: direct link to the order or link cited).",
      "properties": {
        "kind": {
          "enum": [
            "return",
            "order",
            "order_line",
            "customer",
            "link",
            "cluster",
            "variant",
            "anomaly",
            "catalog_task",
            "terms_snapshot",
            "decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "ErrorEvent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "error",
          "title": "Type",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "code": {
          "enum": [
            "llm_unavailable",
            "timeout",
            "internal"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "type",
        "seq",
        "code",
        "message"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "GenerationInfo": {
      "additionalProperties": false,
      "description": "How an LLM output was produced (spec 8.7 validator path, US-901 cached label).",
      "properties": {
        "generation_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Generation Id",
          "type": "string"
        },
        "generation_path": {
          "enum": [
            "llm",
            "llm_regenerated",
            "template"
          ],
          "title": "Generation Path",
          "type": "string"
        },
        "llm_mode": {
          "enum": [
            "vllm",
            "mock"
          ],
          "title": "Llm Mode",
          "type": "string"
        },
        "served_from": {
          "enum": [
            "live",
            "cached"
          ],
          "title": "Served From",
          "type": "string"
        },
        "model": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "attempts": {
          "maximum": 2,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "validator_errors": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "title": "Validator Errors",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latency Ms"
        }
      },
      "required": [
        "generation_id",
        "generation_path",
        "llm_mode",
        "served_from",
        "model",
        "attempts",
        "validator_errors",
        "created_at",
        "latency_ms"
      ],
      "title": "GenerationInfo",
      "type": "object"
    },
    "RefusalEvent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "refusal",
          "title": "Type",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "reason": {
          "enum": [
            "write_request",
            "out_of_scope",
            "step_limit"
          ],
          "title": "Reason",
          "type": "string"
        },
        "text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "type",
        "seq",
        "reason",
        "text"
      ],
      "title": "RefusalEvent",
      "type": "object"
    },
    "TokenEvent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "token",
          "title": "Type",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "text": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "type",
        "seq",
        "text"
      ],
      "title": "TokenEvent",
      "type": "object"
    },
    "ToolCallEvent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "tool_call",
          "title": "Type",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "step": {
          "maximum": 5,
          "minimum": 1,
          "title": "Step",
          "type": "integer"
        },
        "tool": {
          "enum": [
            "get_case",
            "get_orders",
            "get_cluster",
            "get_score_factors",
            "get_policy_text"
          ],
          "title": "Tool",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Arguments",
          "type": "object"
        }
      },
      "required": [
        "type",
        "seq",
        "step",
        "tool",
        "arguments"
      ],
      "title": "ToolCallEvent",
      "type": "object"
    },
    "ToolResultEvent": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "tool_result",
          "title": "Type",
          "type": "string"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "step": {
          "maximum": 5,
          "minimum": 1,
          "title": "Step",
          "type": "integer"
        },
        "tool": {
          "enum": [
            "get_case",
            "get_orders",
            "get_cluster",
            "get_score_factors",
            "get_policy_text"
          ],
          "title": "Tool",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "summary": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "type",
        "seq",
        "step",
        "tool",
        "ok",
        "summary",
        "refs"
      ],
      "title": "ToolResultEvent",
      "type": "object"
    }
  },
  "description": "A whole agent stream, in order. Wire format (text/event-stream), one event per message:\n`event: <type>`, `id: <seq>`, `data: <the event as JSON>`, then a blank line.\n\nOrder: tool_call/tool_result pairs for steps 1..n (n <= 5), then tokens, then exactly one of\nanswer, refusal or error, then done. seq counts from 0 without gaps; the answer text is the\nconcatenation of the tokens.",
  "items": {
    "discriminator": {
      "mapping": {
        "answer": "#/$defs/AnswerEvent",
        "done": "#/$defs/DoneEvent",
        "error": "#/$defs/ErrorEvent",
        "refusal": "#/$defs/RefusalEvent",
        "token": "#/$defs/TokenEvent",
        "tool_call": "#/$defs/ToolCallEvent",
        "tool_result": "#/$defs/ToolResultEvent"
      },
      "propertyName": "type"
    },
    "oneOf": [
      {
        "$ref": "#/$defs/ToolCallEvent"
      },
      {
        "$ref": "#/$defs/ToolResultEvent"
      },
      {
        "$ref": "#/$defs/TokenEvent"
      },
      {
        "$ref": "#/$defs/AnswerEvent"
      },
      {
        "$ref": "#/$defs/RefusalEvent"
      },
      {
        "$ref": "#/$defs/ErrorEvent"
      },
      {
        "$ref": "#/$defs/DoneEvent"
      }
    ]
  },
  "title": "AgentStream",
  "type": "array"
}
