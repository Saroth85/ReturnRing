      "anyOf": [
        {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Return Id"
    }
  },
  "required": [
    "anomaly_id",
    "kind",
    "note",
    "author"
  ],
  "title": "CatalogTaskCreate",
  "type": "object"
