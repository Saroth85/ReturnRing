{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "Assumptions": {
      "additionalProperties": false,
      "description": "An assumption set; basis is policy.simulator's nature: simulated or realized.\n\nOne label, one set of values. A stored version (GET and PUT /api/simulator/assumptions) has\n`based_on` null. Any other set (the alternatives of a case, a week of KPIs, a sensitivity\nscenario) has its own label in `version` and names in `based_on` the stored version whose\nunit costs it uses: the alternatives of a decision version are labelled\n\"<decision_id>/<alternative kind>\", a sensitivity scenario \"<version>/<scenario>\".",
      "properties": {
        "period": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Period",
          "type": "string"
        },
        "logistics_returns_avoided": {
          "minimum": 0,
          "title": "Logistics Returns Avoided",
          "type": "integer"
        },
        "logistics_cost_per_return_eur": {
          "minimum": 0,
          "title": "Logistics Cost Per Return Eur",
          "type": "number"
        },
        "undue_discounts_avoided": {
          "minimum": 0,
          "title": "Undue Discounts Avoided",
          "type": "integer"
        },
        "avg_undue_discount_eur": {
          "minimum": 0,
          "title": "Avg Undue Discount Eur",
          "type": "number"
        },
        "minutes_saved": {
          "minimum": 0,
          "title": "Minutes Saved",
          "type": "number"
        },
        "hourly_cost_eur": {
          "minimum": 0,
          "title": "Hourly Cost Eur",
          "type": "number"
        },
        "incentives_eur": {
          "minimum": 0,
          "title": "Incentives Eur",
          "type": "number"
        },
        "system_cost_eur": {
          "minimum": 0,
          "title": "System Cost Eur",
          "type": "number"
        },
        "error_cost_eur": {
          "minimum": 0,
          "title": "Error Cost Eur",
          "type": "number"
        },
        "abandonment_margin_lost_eur": {
          "minimum": 0,
          "title": "Abandonment Margin Lost Eur",
          "type": "number"
        },
        "incremental_margin_eur": {
          "minimum": 0,
          "title": "Incremental Margin Eur",
          "type": "number"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "basis": {
          "enum": [
            "simulated",
            "realized"
          ],
          "title": "Basis",
          "type": "string"
        },
        "based_on": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Based On"
        }
      },
      "required": [
        "period",
        "logistics_returns_avoided",
        "logistics_cost_per_return_eur",
        "undue_discounts_avoided",
        "avg_undue_discount_eur",
        "minutes_saved",
        "hourly_cost_eur",
        "incentives_eur",
        "system_cost_eur",
        "error_cost_eur",
        "abandonment_margin_lost_eur",
        "incremental_margin_eur",
        "version",
        "basis",
        "based_on"
      ],
      "title": "Assumptions",
      "type": "object"
    },
    "CohortRate": {
      "additionalProperties": false,
      "properties": {
        "cohort": {
          "enum": [
            "all",
            "new_customers",
            "households",
            "low_data",
            "high_value"
          ],
          "title": "Cohort",
          "type": "string"
        },
        "false_positive_rate": {
          "$ref": "#/$defs/Metric"
        },
        "customers": {
          "$ref": "#/$defs/Metric"
        }
      },
      "required": [
        "cohort",
        "false_positive_rate",
        "customers"
      ],
      "title": "CohortRate",
      "type": "object"
    },
    "DecisionCounts": {
      "additionalProperties": false,
      "properties": {
        "total": {
          "$ref": "#/$defs/Metric"
        },
        "approved": {
          "$ref": "#/$defs/Metric"
        },
        "overridden": {
          "$ref": "#/$defs/Metric"
        },
        "rejected": {
          "$ref": "#/$defs/Metric"
        },
        "pending": {
          "$ref": "#/$defs/Metric"
        }
      },
      "required": [
        "total",
        "approved",
        "overridden",
        "rejected",
        "pending"
      ],
      "title": "DecisionCounts",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "A figure shown in the UI: its value, its unit and where it comes from.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "eur",
            "usd",
            "count",
            "expected_count",
            "ratio",
            "probability",
            "percent",
            "percentage_points",
            "z_score",
            "score",
            "days",
            "seconds",
            "milliseconds",
            "tokens_per_second",
            "gib",
            "watts"
          ],
          "title": "Unit",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "value",
        "unit",
        "provenance"
      ],
      "title": "Metric",
      "type": "object"
    },
    "NetBenefitComponent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "logistics_costs_avoided",
            "undue_discounts_avoided",
            "time_saved_value",
            "incremental_margin",
            "incentives",
            "system_cost",
            "error_cost",
            "abandonment_margin_lost"
          ],
          "title": "Id",
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/Metric"
        }
      },
      "required": [
        "id",
        "amount"
      ],
      "title": "NetBenefitComponent",
      "type": "object"
    },
    "NetBenefitView": {
      "additionalProperties": false,
      "description": "Net benefit with disjoint components, exactly as policy.simulator.net_benefit computes it\nfrom `assumptions` (a validator recomputes it).",
      "properties": {
        "assumptions": {
          "$ref": "#/$defs/Assumptions"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/NetBenefitComponent"
          },
          "title": "Components",
          "type": "array"
        },
        "total": {
          "$ref": "#/$defs/Metric"
        }
      },
      "required": [
        "assumptions",
        "components",
        "total"
      ],
      "title": "NetBenefitView",
      "type": "object"
    },
    "OverrideReasonCount": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "evidence_disagreement",
            "customer_context",
            "linked_accounts_explained",
            "policy_exception",
            "periodic_review",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "count": {
          "$ref": "#/$defs/Metric"
        }
      },
      "required": [
        "category",
        "count"
      ],
      "title": "OverrideReasonCount",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a number comes from: origin, period and nature (same fields as contracts.io).",
      "properties": {
        "origin": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "nature": {
          "enum": [
            "real",
            "synthetic",
            "simulated"
          ],
          "title": "Nature",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "period_start",
        "period_end",
        "nature"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "KPIs of a week (US-603). False positives need labels, so they come from the offline\nevaluation report (evaluation_report_id): the API never reads data/truth/ (rule 12).",
  "properties": {
    "period_start": {
      "format": "date",
      "title": "Period Start",
      "type": "string"
    },
    "period_end": {
      "format": "date",
      "title": "Period End",
      "type": "string"
    },
    "net_benefit_simulated": {
      "$ref": "#/$defs/NetBenefitView"
    },
    "net_benefit_realized": {
      "anyOf": [
        {
          "$ref": "#/$defs/NetBenefitView"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluation_report_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Evaluation Report Id",
      "type": "string"
    },
    "false_positives": {
      "items": {
        "$ref": "#/$defs/CohortRate"
      },
      "minItems": 1,
      "title": "False Positives",
      "type": "array"
    },
    "decision_time_p50": {
      "$ref": "#/$defs/Metric"
    },
    "decision_time_p95": {
      "$ref": "#/$defs/Metric"
    },
    "abstentions_insufficient_evidence": {
      "$ref": "#/$defs/Metric"
    },
    "abstention_rate": {
      "$ref": "#/$defs/Metric"
    },
    "decisions": {
      "$ref": "#/$defs/DecisionCounts"
    },
    "override_reasons": {
      "items": {
        "$ref": "#/$defs/OverrideReasonCount"
      },
      "title": "Override Reasons",
      "type": "array"
    },
    "open_catalog_tasks": {
      "$ref": "#/$defs/Metric"
    }
  },
  "required": [
    "period_start",
    "period_end",
    "net_benefit_simulated",
    "net_benefit_realized",
    "evaluation_report_id",
    "false_positives",
    "decision_time_p50",
    "decision_time_p95",
    "abstentions_insufficient_evidence",
    "abstention_rate",
    "decisions",
    "override_reasons",
    "open_catalog_tasks"
  ],
  "title": "KpiResponse",
  "type": "object"
}
