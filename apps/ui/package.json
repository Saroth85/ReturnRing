{
  "name": "returnring-ui",
  "private": true,
  "version": "0.1.0",
  "description": "ReturnRing operator, manager and platform UI (phase 5, docs/ui-design.md)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:live": "vite --mode live",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build && node scripts/check-bundle.mjs",
    "build:mock": "vite build --mode mock --outDir dist-mock",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:types": "node scripts/gen-types.mjs && node scripts/gen-contract.mjs",
    "gen:api": "npm run gen:types",
    "check:types-gen": "node scripts/gen-types.mjs --check && node scripts/gen-contract.mjs --check",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "npm run check:types-gen && npm run typecheck && npm run lint && npm test && npm run check:licenses && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.104.0",
    "clsx": "2.1.1",
    "cytoscape": "3.34.3",
    "lucide-react": "1.47.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.4",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.18",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "happy-dom": "20.14.5",
    "json-schema-to-typescript": "15.0.4",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
