{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "additionalProperties": false,
  "description": "A question about one case. The answer streams as server-sent events (AgentEvent).",
  "properties": {
    "return_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Return Id",
      "type": "string"
    },
    "question": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "lang": {
      "default": "en",
      "enum": [
        "it",
        "en"
      ],
      "title": "Lang",
      "type": "string"
    },
    "asked_by": {
      "not": {
        "const": "system"
      },
      "pattern": "^[a-z][a-z0-9._-]{1,31}$",
      "title": "Asked By",
      "type": "string"
    }
  },
  "required": [
    "return_id",
    "question",
    "asked_by"
  ],
  "title": "AgentAskRequest",
  "type": "object"
}
