{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "AuditEntry": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "action": {
                "not": {
                  "enum": [
                    "case_recomputed",
                    "decision_approved",
                    "decision_overridden",
                    "decision_proposed",
                    "decision_rejected",
                    "restriction_lifted",
                    "restriction_renewed"
                  ]
                }
              }
            }
          },
          "if": {
            "properties": {
              "entity_type": {
                "const": "decision"
              }
            },
            "required": [
              "entity_type"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "enum": [
                  "case_recomputed",
                  "decision_approved",
                  "decision_overridden",
                  "decision_proposed",
                  "decision_rejected",
                  "restriction_lifted",
                  "restriction_renewed"
                ]
              },
              "before": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/DecisionAuditState"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "after": {
                "$ref": "#/$defs/DecisionAuditState"
              }
            }
          }
        }
      ],
      "description": "One row of the append-only audit log (US-604).\n\nThe entries about a decision version (entity_type decision, actions DECISION_AUDIT_ACTIONS)\nname its return and carry a typed before and after (DecisionAuditState). approve, override\nand reject change a proposed version; restriction_lifted, restriction_renewed and\ncase_recomputed create the next version, so before and after are two versions.",
      "properties": {
        "entry_id": {
          "minimum": 1,
          "title": "Entry Id",
          "type": "integer"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "actor": {
          "pattern": "^[a-z][a-z0-9._-]{1,31}$",
          "title": "Actor",
          "type": "string"
        },
        "actor_role": {
          "enum": [
            "operator",
            "manager",
            "warehouse",
            "system"
          ],
          "title": "Actor Role",
          "type": "string"
        },
        "action": {
          "enum": [
            "decision_proposed",
            "decision_approved",
            "decision_overridden",
            "decision_rejected",
            "restriction_lifted",
            "restriction_renewed",
            "case_recomputed",
            "draft_generated",
            "draft_regenerated",
            "message_queued",
            "evidence_added",
            "link_disputed",
            "checkout_terms_shown",
            "checkout_confirmed",
            "inspection_created",
            "inspection_confirmed",
            "catalog_task_opened",
            "catalog_task_updated",
            "coupon_rule_approved",
            "coupon_rule_application_reversed",
            "assumptions_updated"
          ],
          "title": "Action",
          "type": "string"
        },
        "entity_type": {
          "enum": [
            "decision",
            "llm_generation",
            "outbox_message",
            "evidence_addition",
            "link_dispute",
            "terms_snapshot",
            "inspection",
            "catalog_task",
            "coupon_rule",
            "coupon_rule_application",
            "simulator_assumptions"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "entity_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Entity Id",
          "type": "string"
        },
        "return_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Return Id"
        },
        "decision_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decision Id"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 3,
              "pattern": "\\S[\\s\\S]+\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionAuditState"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before"
        },
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionAuditState"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "After"
        },
        "rules_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rules Version"
        },
        "model_versions": {
          "anyOf": [
            {
              "additionalProperties": {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Versions"
        },
        "assumptions_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Assumptions Version"
        },
        "request_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Request Id"
        }
      },
      "required": [
        "entry_id",
        "at",
        "actor",
        "actor_role",
        "action",
        "entity_type",
        "entity_id",
        "return_id",
        "decision_id",
        "reason",
        "before",
        "after",
        "rules_version",
        "model_versions",
        "assumptions_version",
        "request_id"
      ],
      "title": "AuditEntry",
      "type": "object"
    },
    "DecisionAuditState": {
      "additionalProperties": false,
      "description": "The before and after of an audit entry about a decision version (entity_type decision):\nwhat changed, with the id that serves the whole version (GET /api/decisions/{decision_id}).",
      "properties": {
        "decision_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Decision Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "state": {
          "enum": [
            "proposed",
            "approved",
            "overridden",
            "rejected"
          ],
          "title": "State",
          "type": "string"
        },
        "quadrant": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quadrant"
            },
            {
              "type": "null"
            }
          ]
        },
        "risk": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ]
        },
        "lever_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 3,
            "type": "string"
          },
          "title": "Lever Ids",
          "type": "array"
        },
        "requires_approval": {
          "title": "Requires Approval",
          "type": "boolean"
        },
        "review_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Review At"
        },
        "approver": {
          "anyOf": [
            {
              "not": {
                "const": "system"
              },
              "pattern": "^[a-z][a-z0-9._-]{1,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approver"
        },
        "override_category": {
          "anyOf": [
            {
              "enum": [
                "evidence_disagreement",
                "customer_context",
                "linked_accounts_explained",
                "policy_exception",
                "periodic_review",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Override Category"
        },
        "coupon_application_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Coupon Application Id"
        }
      },
      "required": [
        "decision_id",
        "version",
        "state",
        "quadrant",
        "risk",
        "lever_ids",
        "requires_approval",
        "review_at",
        "approver",
        "override_category",
        "coupon_application_id"
      ],
      "title": "DecisionAuditState",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "A figure shown in the UI: its value, its unit and where it comes from.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "eur",
            "usd",
            "count",
            "expected_count",
            "ratio",
            "probability",
            "percent",
            "percentage_points",
            "z_score",
            "score",
            "days",
            "seconds",
            "milliseconds",
            "tokens_per_second",
            "gib",
            "watts"
          ],
          "title": "Unit",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "value",
        "unit",
        "provenance"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a number comes from: origin, period and nature (same fields as contracts.io).",
      "properties": {
        "origin": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "nature": {
          "enum": [
            "real",
            "synthetic",
            "simulated"
          ],
          "title": "Nature",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "period_start",
        "period_end",
        "nature"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Quadrant": {
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "Q4"
      ],
      "title": "Quadrant",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/AuditEntry"
      },
      "title": "Items",
      "type": "array"
    },
    "total": {
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    },
    "page": {
      "minimum": 1,
      "title": "Page",
      "type": "integer"
    },
    "page_size": {
      "maximum": 500,
      "minimum": 1,
      "title": "Page Size",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "total",
    "page",
    "page_size"
  ],
  "title": "AuditPage",
  "type": "object"
}
