      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "B1",
            "B2",
            "B3",
            "B4"
          ],
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "status": {
          "enum": [
            "measured",
            "pending",
            "illustrative"
          ],
          "title": "Status",
          "type": "string"
        },
        "measured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Measured At"
        },
        "dataset": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Dataset",
          "type": "string"
        },
        "versions": {
          "additionalProperties": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "title": "Versions",
          "type": "object"
        },
        "config": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Config",
          "type": "object"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/BenchmarkResult"
          },
          "title": "Results",
          "type": "array"
        },
        "notes": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "measured_at",
        "dataset",
        "versions",
        "config",
        "results",
        "notes"
      ],
      "title": "Benchmark",
      "type": "object"
    },
    "BenchmarkResult": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "label": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "device": {
          "enum": [
            "cpu",
            "mi300x"
          ],
          "title": "Device",
          "type": "string"
        },
        "phase": {
          "enum": [
            "cold_start",
            "training",
            "scoring",
            "generation",
            "pipeline",
            "cost"
          ],
          "title": "Phase",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Metric"
        },
        "concurrency": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Concurrency"
        },
        "batch_size": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Batch Size"
        },
        "protocol": {
          "anyOf": [
            {
              "enum": [
                "paper",
                "decision_time"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Protocol"
        }
      },
      "required": [
        "metric",
        "label",
        "device",
        "phase",
        "value",
        "concurrency",
        "batch_size",
        "protocol"
      ],
      "title": "BenchmarkResult",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "A figure shown in the UI: its value, its unit and where it comes from.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "eur",
            "usd",
            "count",
            "expected_count",
            "ratio",
            "probability",
            "percent",
            "percentage_points",
            "z_score",
            "score",
            "days",
            "seconds",
            "milliseconds",
            "tokens_per_second",
            "gib",
            "watts"
          ],
          "title": "Unit",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "value",
        "unit",
        "provenance"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a number comes from: origin, period and nature (same fields as contracts.io).",
      "properties": {
        "origin": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "nature": {
          "enum": [
            "real",
            "synthetic",
            "simulated"
          ],
          "title": "Nature",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "period_start",
        "period_end",
        "nature"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/Benchmark"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "BenchmarksResponse",
  "type": "object"
}
