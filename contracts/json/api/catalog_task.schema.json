{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "FollowUp": {
      "additionalProperties": false,
      "description": "The variant's return rate for the reason before and after the change (US-606).",
      "properties": {
        "baseline_rate": {
          "$ref": "#/$defs/Metric"
        },
        "after_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ]
        },
        "weeks_after": {
          "minimum": 0,
          "title": "Weeks After",
          "type": "integer"
        },
        "caveat": {
          "const": "A decrease alone does not prove the effect of the correction: that needs a controlled comparison.",
          "default": "A decrease alone does not prove the effect of the correction: that needs a controlled comparison.",
          "title": "Caveat",
          "type": "string"
        }
      },
      "required": [
        "baseline_rate",
        "after_rate",
        "weeks_after",
        "caveat"
      ],
      "title": "FollowUp",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "A figure shown in the UI: its value, its unit and where it comes from.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "eur",
            "usd",
            "count",
            "expected_count",
            "ratio",
            "probability",
            "percent",
            "percentage_points",
            "z_score",
            "score",
            "days",
            "seconds",
            "milliseconds",
            "tokens_per_second",
            "gib",
            "watts"
          ],
          "title": "Unit",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "value",
        "unit",
        "provenance"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a number comes from: origin, period and nature (same fields as contracts.io).",
      "properties": {
        "origin": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "nature": {
          "enum": [
            "real",
            "synthetic",
            "simulated"
          ],
          "title": "Nature",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "period_start",
        "period_end",
        "nature"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ReturnReason": {
      "enum": [
        "size",
        "changed_mind",
        "not_as_expected",
        "defective",
        "damaged_in_shipping",
        "wrong_item",
        "not_as_described",
        "other"
      ],
      "title": "ReturnReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Task Id",
      "type": "string"
    },
    "anomaly_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Anomaly Id",
      "type": "string"
    },
    "variant_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Variant Id",
      "type": "string"
    },
    "reason": {
      "$ref": "#/$defs/ReturnReason"
    },
    "kind": {
      "enum": [
        "description",
        "size_guide",
        "batch_check"
      ],
      "title": "Kind",
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "in_progress",
        "done",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "note": {
      "maxLength": 1000,
      "minLength": 3,
      "title": "Note",
      "type": "string"
    },
    "created_by": {
      "not": {
        "const": "system"
      },
      "pattern": "^[a-z][a-z0-9._-]{1,31}$",
      "title": "Created By",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "done_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Done At"
    },
    "return_id": {
      "anyOf": [
        {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Return Id"
    },
    "follow_up": {
      "anyOf": [
        {
          "$ref": "#/$defs/FollowUp"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "task_id",
    "anomaly_id",
    "variant_id",
    "reason",
    "kind",
    "status",
    "note",
    "created_by",
    "created_at",
    "updated_at",
    "done_at",
    "return_id",
    "follow_up"
  ],
  "title": "CatalogTask",
  "type": "object"
}
