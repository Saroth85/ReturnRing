{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "Quadrant": {
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "Q4"
      ],
      "title": "Quadrant",
      "type": "string"
    },
    "Terms": {
      "additionalProperties": false,
      "description": "Return terms (policy.types.ReturnTerms): the window never goes below 14 days (rule 3).",
      "properties": {
        "return_window_days": {
          "minimum": 14,
          "title": "Return Window Days",
          "type": "integer"
        },
        "free_return_shipping": {
          "title": "Free Return Shipping",
          "type": "boolean"
        },
        "instant_refund": {
          "title": "Instant Refund",
          "type": "boolean"
        },
        "free_size_exchange": {
          "title": "Free Size Exchange",
          "type": "boolean"
        },
        "coupons_enabled": {
          "title": "Coupons Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "return_window_days",
        "free_return_shipping",
        "instant_refund",
        "free_size_exchange",
        "coupons_enabled"
      ],
      "title": "Terms",
      "type": "object"
    },
    "TermsSnapshotView": {
      "additionalProperties": false,
      "description": "Terms shown at checkout and stored with the order (ADR-05). order_id is null while the\nsnapshot is shown and not confirmed (POST /api/checkout/evaluate). base_terms are the\nmerchant base terms when the snapshot was shown; review_at is the review date of the\nrestriction in force that produced the terms, if any. coupon_application_id and\ncoupon_review_at name the cluster coupon block shown with the terms, which turned their\ncoupons off (1.5.0, H12; null without a block).",
      "properties": {
        "terms_snapshot_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Terms Snapshot Id",
          "type": "string"
        },
        "order_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Order Id"
        },
        "customer_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Customer Id",
          "type": "string"
        },
        "source": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Source",
          "type": "string"
        },
        "quadrant_at_purchase": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quadrant"
            },
            {
              "type": "null"
            }
          ]
        },
        "terms": {
          "$ref": "#/$defs/Terms"
        },
        "base_terms": {
          "$ref": "#/$defs/Terms"
        },
        "review_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Review At"
        },
        "coupon_application_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Coupon Application Id"
        },
        "coupon_review_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Coupon Review At"
        },
        "shown_at": {
          "format": "date-time",
          "title": "Shown At",
          "type": "string"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confirmed At"
        }
      },
      "required": [
        "terms_snapshot_id",
        "order_id",
        "customer_id",
        "source",
        "quadrant_at_purchase",
        "terms",
        "base_terms",
        "review_at",
        "coupon_application_id",
        "coupon_review_at",
        "shown_at",
        "confirmed_at"
      ],
      "title": "TermsSnapshotView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "order_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Order Id",
      "type": "string"
    },
    "terms_snapshot": {
      "$ref": "#/$defs/TermsSnapshotView"
    },
    "coupon_applied": {
      "title": "Coupon Applied",
      "type": "boolean"
    }
  },
  "required": [
    "order_id",
    "terms_snapshot",
    "coupon_applied"
  ],
  "title": "CheckoutConfirmResponse",
  "type": "object"
}
