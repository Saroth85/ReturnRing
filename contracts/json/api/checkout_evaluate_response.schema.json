{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "CheckoutLine": {
      "additionalProperties": false,
      "properties": {
        "variant_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Variant Id",
          "type": "string"
        },
        "size": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Size",
          "type": "string"
        },
        "p_return": {
          "maximum": 1,
          "minimum": 0,
          "title": "P Return",
          "type": "number"
        },
        "size_advice": {
          "anyOf": [
            {
              "$ref": "#/$defs/SizeAdvice"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "variant_id",
        "size",
        "p_return",
        "size_advice"
      ],
      "title": "CheckoutLine",
      "type": "object"
    },
    "CouponBlock": {
      "additionalProperties": false,
      "description": "Why coupons are off for this customer: a confirmed cluster rule application (US-402).",
      "properties": {
        "rule_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "application_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Application Id",
          "type": "string"
        },
        "review_at": {
          "format": "date",
          "title": "Review At",
          "type": "string"
        },
        "text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "rule_version",
        "application_id",
        "review_at",
        "text"
      ],
      "title": "CouponBlock",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a number comes from: origin, period and nature (same fields as contracts.io).",
      "properties": {
        "origin": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "nature": {
          "enum": [
            "real",
            "synthetic",
            "simulated"
          ],
          "title": "Nature",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "period_start",
        "period_end",
        "nature"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Quadrant": {
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "Q4"
      ],
      "title": "Quadrant",
      "type": "string"
    },
    "SizeAdvice": {
      "additionalProperties": false,
      "description": "US-401: a specific size only with measurement and exchange data; otherwise the size guide\nor a plain statement that no reliable recommendation exists.",
      "properties": {
        "kind": {
          "enum": [
            "specific",
            "measurement_guide",
            "no_reliable_recommendation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "suggested_size": {
          "anyOf": [
            {
              "maxLength": 16,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Suggested Size"
        },
        "text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "suggested_size",
        "text"
      ],
      "title": "SizeAdvice",
      "type": "object"
    },
    "Terms": {
      "additionalProperties": false,
      "description": "Return terms (policy.types.ReturnTerms): the window never goes below 14 days (rule 3).",
      "properties": {
        "return_window_days": {
          "minimum": 14,
          "title": "Return Window Days",
          "type": "integer"
        },
        "free_return_shipping": {
          "title": "Free Return Shipping",
          "type": "boolean"
        },
        "instant_refund": {
          "title": "Instant Refund",
          "type": "boolean"
        },
        "free_size_exchange": {
          "title": "Free Size Exchange",
          "type": "boolean"
        },
        "coupons_enabled": {
          "title": "Coupons Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "return_window_days",
        "free_return_shipping",
        "instant_refund",
        "free_size_exchange",
        "coupons_enabled"
      ],
      "title": "Terms",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Spec 19.B, plus the provenance of the numbers, the source of the terms and the shown\nsnapshot: the API stores the terms shown before answering, and /confirm binds them to the\norder (E2E-02: terms shown = snapshot stored).",
  "properties": {
    "customer_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Customer Id",
      "type": "string"
    },
    "quadrant": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quadrant"
        },
        {
          "type": "null"
        }
      ]
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/CheckoutLine"
      },
      "minItems": 1,
      "title": "Lines",
      "type": "array"
    },
    "terms": {
      "$ref": "#/$defs/Terms"
    },
    "base_terms": {
      "$ref": "#/$defs/Terms"
    },
    "coupon_eligible": {
      "title": "Coupon Eligible",
      "type": "boolean"
    },
    "coupon_block": {
      "anyOf": [
        {
          "$ref": "#/$defs/CouponBlock"
        },
        {
          "type": "null"
        }
      ]
    },
    "terms_snapshot_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Terms Snapshot Id",
      "type": "string"
    },
    "terms_source": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Terms Source",
      "type": "string"
    },
    "review_at": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Review At"
    },
    "shown_at": {
      "format": "date-time",
      "title": "Shown At",
      "type": "string"
    },
    "p_return_threshold": {
      "maximum": 1,
      "minimum": 0,
      "title": "P Return Threshold",
      "type": "number"
    },
    "model_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Model Version",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "customer_id",
    "quadrant",
    "lines",
    "terms",
    "base_terms",
    "coupon_eligible",
    "coupon_block",
    "terms_snapshot_id",
    "terms_source",
    "review_at",
    "shown_at",
    "p_return_threshold",
    "model_version",
    "provenance"
  ],
  "title": "CheckoutEvaluateResponse",
  "type": "object"
}
