{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "CouponRule": {
      "additionalProperties": false,
      "description": "A version of the general rule approved by the manager. The engine applies it to a Q4 case\nof a customer in a cluster: coupons off for every account of the cluster, future orders.",
      "properties": {
        "rule_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "approved_by": {
          "not": {
            "const": "system"
          },
          "pattern": "^[a-z][a-z0-9._-]{1,31}$",
          "title": "Approved By",
          "type": "string"
        },
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "supersedes": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supersedes"
        },
        "active": {
          "title": "Active",
          "type": "boolean"
        }
      },
      "required": [
        "rule_version",
        "text",
        "approved_by",
        "approved_at",
        "supersedes",
        "active"
      ],
      "title": "CouponRule",
      "type": "object"
    },
    "CouponRuleApplication": {
      "additionalProperties": false,
      "description": "The rule applied to one cluster: proposed with a decision, confirmed by the operator who\napproves it, always reversible, with a review date.",
      "properties": {
        "application_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Application Id",
          "type": "string"
        },
        "rule_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "cluster_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Cluster Id",
          "type": "string"
        },
        "decision_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Decision Id",
          "type": "string"
        },
        "affected_customer_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Customer Ids",
          "type": "array"
        },
        "state": {
          "enum": [
            "proposed",
            "confirmed",
            "reversed"
          ],
          "title": "State",
          "type": "string"
        },
        "proposed_at": {
          "format": "date-time",
          "title": "Proposed At",
          "type": "string"
        },
        "confirmed_by": {
          "anyOf": [
            {
              "not": {
                "const": "system"
              },
              "pattern": "^[a-z][a-z0-9._-]{1,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confirmed By"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confirmed At"
        },
        "review_at": {
          "format": "date",
          "title": "Review At",
          "type": "string"
        },
        "reversible": {
          "const": true,
          "default": true,
          "title": "Reversible",
          "type": "boolean"
        },
        "reversed_by": {
          "anyOf": [
            {
              "not": {
                "const": "system"
              },
              "pattern": "^[a-z][a-z0-9._-]{1,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reversed By"
        },
        "reversed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reversed At"
        },
        "reversal_reason": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reversal Reason"
        }
      },
      "required": [
        "application_id",
        "rule_version",
        "cluster_id",
        "decision_id",
        "affected_customer_ids",
        "state",
        "proposed_at",
        "confirmed_by",
        "confirmed_at",
        "review_at",
        "reversible",
        "reversed_by",
        "reversed_at",
        "reversal_reason"
      ],
      "title": "CouponRuleApplication",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "current": {
      "$ref": "#/$defs/CouponRule"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/CouponRule"
      },
      "minItems": 1,
      "title": "History",
      "type": "array"
    },
    "applications": {
      "items": {
        "$ref": "#/$defs/CouponRuleApplication"
      },
      "title": "Applications",
      "type": "array"
    }
  },
  "required": [
    "current",
    "history",
    "applications"
  ],
  "title": "CouponRulesResponse",
  "type": "object"
}
