{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "MessageChoice": {
      "additionalProperties": false,
      "description": "The customer message to send after approve, override or reject: its language and,\noptionally, a selection of phrasebook ids (llm/phrasebook.py) other than the default one.\nThe operator chooses reviewed sentences, never free text (ADR-14 decision 8). The API\ncomposes the message for the decision acted on with llm.phrasebook.render_selection (the\nmandatory body, the template fields and the legal clause come from the decision) and\nrefuses a selection that is not allowed for it (422 invalid_request). Without sentence_ids:\nthe draft's selection when it is allowed for the decision acted on, otherwise the fallback\nselection of llm.templates (default_selection_for).",
      "properties": {
        "lang": {
          "enum": [
            "it",
            "en"
          ],
          "title": "Lang",
          "type": "string"
        },
        "sentence_ids": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "OPEN_THANKS",
                  "OPEN_MESSAGE",
                  "OPEN_CHOICE",
                  "OPEN_SORRY_FIT",
                  "OPEN_SORRY_ITEM",
                  "HELP_SIZE",
                  "HELP_ADVICE",
                  "CONTACT_REPLY",
                  "CONTACT_TEAM",
                  "INFO_TERMS",
                  "GUARANTEE_CARE",
                  "GUARANTEE_PHOTO",
                  "THANKS_FEEDBACK",
                  "CLOSE_REGARDS",
                  "CLOSE_VALUED",
                  "CLOSE_HAPPY",
                  "CLOSE_DAY",
                  "CLOSE_SOON",
                  "CLOSE_PATIENCE"
                ],
                "type": "string"
              },
              "maxItems": 5,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentence Ids"
        }
      },
      "required": [
        "lang"
      ],
      "title": "MessageChoice",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "override_reason": {
            "type": "null"
          },
          "override_category": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "action": {
            "enum": [
              "override",
              "reject",
              "lift"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "override_reason": {
            "type": "string"
          },
          "override_category": {
            "type": "string"
          }
        },
        "required": [
          "override_reason",
          "override_category"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "override"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "levers": {
            "type": "array"
          }
        },
        "required": [
          "levers"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "reject",
              "lift",
              "renew"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "levers": {
            "type": "null"
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "message": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "action": {
            "enum": [
              "approve",
              "override",
              "reject"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "message": {
            "type": "object"
          }
        },
        "required": [
          "message"
        ]
      }
    }
  ],
  "description": "POST /api/returns/{return_id}/decision (spec 19.B, plus decision_id and the category).\n\napprove: confirm the proposal (levers, if sent, must equal it: 409 otherwise); override:\nreplace the levers, with a reason and a category, checked by the legal guard (422); reject:\ndiscard the proposal (no lever applies, the order's terms stay; the return itself is never\nrefused), with a reason and a category. The three act on a proposed version.\n\nlift and renew (US-607) review an approved or overridden restriction, the latest version\n(409 if it is not a restriction). Each creates the next version (trigger review) from\npolicy.engine.decide() on the latest scores at the day of the review. lift ends the\nrestriction, before or after its review date (a review, or a rectification the customer\nasked for), with a reason and a category: the new version is overridden to the standard\nlevers, and the cluster coupon application of the restriction, if any, is reversed. renew\nkeeps a restriction, at or after its review date (409 before), with no levers and no reason:\nthe person approves the fresh proposal, which gets a new review date (409 if the fresh\nproposal is not a restriction: lift it).\n\napprove, override and reject send one message to the outbox (`message` required). lift and\nrenew send none (`message` null), as decided on 13 Oct 2026 (ADR-15 section 12, spec 19.B):\nthe customer sees the terms of a lift or a renewal at checkout, before each purchase\n(US-403). A restriction is approved before its review date: a stale proposal answers 409\nand the case is recomputed.",
  "properties": {
    "decision_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Decision Id",
      "type": "string"
    },
    "action": {
      "enum": [
        "approve",
        "override",
        "reject",
        "lift",
        "renew"
      ],
      "title": "Action",
      "type": "string"
    },
    "levers": {
      "anyOf": [
        {
          "allOf": [
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "return_window_days"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "maxContains": 1,
              "minContains": 0
            },
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "free_return_shipping"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "maxContains": 1,
              "minContains": 0
            },
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "instant_refund"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "maxContains": 1,
              "minContains": 0
            },
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "free_size_exchange"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "maxContains": 1,
              "minContains": 0
            },
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "coupons_enabled"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "maxContains": 1,
              "minContains": 0
            },
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "cluster_coupons_disabled"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "maxContains": 1,
              "minContains": 0
            },
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "transparency_notice"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "maxContains": 1,
              "minContains": 0
            },
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "size_advice"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "maxContains": 1,
              "minContains": 0
            },
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "priority_size_exchange"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "maxContains": 1,
              "minContains": 0
            }
          ],
          "items": {
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "id": {
                      "const": "return_window_days"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "minimum": 14,
                      "type": "integer"
                    },
                    "scope": {
                      "const": "future_orders"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": {
                      "const": "free_return_shipping"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "boolean"
                    },
                    "scope": {
                      "const": "future_orders"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": {
                      "const": "instant_refund"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "boolean"
                    },
                    "scope": {
                      "const": "future_orders"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": {
                      "const": "free_size_exchange"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "const": true,
                      "type": "boolean"
                    },
                    "scope": {
                      "const": "all_orders"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": {
                      "const": "coupons_enabled"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "boolean"
                    },
                    "scope": {
                      "const": "future_orders"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": {
                      "const": "cluster_coupons_disabled"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "boolean"
                    },
                    "scope": {
                      "const": "future_orders_cluster"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": {
                      "const": "transparency_notice"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "boolean"
                    },
                    "scope": {
                      "const": "communication"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": {
                      "const": "size_advice"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "boolean"
                    },
                    "scope": {
                      "const": "current_order"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "id": {
                      "const": "priority_size_exchange"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "const": true,
                      "type": "boolean"
                    },
                    "scope": {
                      "const": "all_orders"
                    }
                  }
                }
              }
            ],
            "properties": {
              "id": {
                "enum": [
                  "return_window_days",
                  "free_return_shipping",
                  "instant_refund",
                  "free_size_exchange",
                  "coupons_enabled",
                  "cluster_coupons_disabled",
                  "transparency_notice",
                  "size_advice",
                  "priority_size_exchange"
                ]
              },
              "value": {
                "type": [
                  "integer",
                  "boolean"
                ]
              },
              "scope": {
                "enum": [
                  "future_orders",
                  "future_orders_cluster",
                  "all_orders",
                  "current_order",
                  "communication"
                ]
              }
            },
            "required": [
              "id",
              "value",
              "scope"
            ],
            "type": "object"
          },
          "maxItems": 9,
          "type": "array",
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Levers"
    },
    "message": {
      "anyOf": [
        {
          "$ref": "#/$defs/MessageChoice"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "override_reason": {
      "anyOf": [
        {
          "maxLength": 1000,
          "minLength": 3,
          "pattern": "\\S[\\s\\S]+\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Override Reason"
    },
    "override_category": {
      "anyOf": [
        {
          "enum": [
            "evidence_disagreement",
            "customer_context",
            "linked_accounts_explained",
            "policy_exception",
            "periodic_review",
            "other"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Override Category"
    },
    "approver": {
      "not": {
        "const": "system"
      },
      "pattern": "^[a-z][a-z0-9._-]{1,31}$",
      "title": "Approver",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "action",
    "approver"
  ],
  "title": "DecisionRequest",
  "type": "object"
}
