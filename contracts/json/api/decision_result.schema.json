            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              },
              "scope": {
                "const": "communication"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "size_advice"
              }
