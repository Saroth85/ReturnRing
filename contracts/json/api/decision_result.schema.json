{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "AuditEntry": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "action": {
                "not": {
                  "enum": [
                    "case_recomputed",
                    "decision_approved",
                    "decision_overridden",
                    "decision_proposed",
                    "decision_rejected",
                    "restriction_lifted",
                    "restriction_renewed"
                  ]
                }
              }
            }
          },
          "if": {
            "properties": {
              "entity_type": {
                "const": "decision"
              }
            },
            "required": [
              "entity_type"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "enum": [
                  "case_recomputed",
                  "decision_approved",
                  "decision_overridden",
                  "decision_proposed",
                  "decision_rejected",
                  "restriction_lifted",
                  "restriction_renewed"
                ]
              },
              "before": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/DecisionAuditState"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "after": {
                "$ref": "#/$defs/DecisionAuditState"
              }
            }
          }
        }
      ],
      "description": "One row of the append-only audit log (US-604).\n\nThe entries about a decision version (entity_type decision, actions DECISION_AUDIT_ACTIONS)\nname its return and carry a typed before and after (DecisionAuditState). approve, override\nand reject change a proposed version; restriction_lifted, restriction_renewed and\ncase_recomputed create the next version, so before and after are two versions.",
      "properties": {
        "entry_id": {
          "minimum": 1,
          "title": "Entry Id",
          "type": "integer"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "actor": {
          "pattern": "^[a-z][a-z0-9._-]{1,31}$",
          "title": "Actor",
          "type": "string"
        },
        "actor_role": {
          "enum": [
            "operator",
            "manager",
            "warehouse",
            "system"
          ],
          "title": "Actor Role",
          "type": "string"
        },
        "action": {
          "enum": [
            "decision_proposed",
            "decision_approved",
            "decision_overridden",
            "decision_rejected",
            "restriction_lifted",
            "restriction_renewed",
            "case_recomputed",
            "draft_generated",
            "draft_regenerated",
            "message_queued",
            "evidence_added",
            "link_disputed",
            "checkout_terms_shown",
            "checkout_confirmed",
            "inspection_created",
            "inspection_confirmed",
            "catalog_task_opened",
            "catalog_task_updated",
            "coupon_rule_approved",
            "coupon_rule_application_reversed",
            "assumptions_updated"
          ],
          "title": "Action",
          "type": "string"
        },
        "entity_type": {
          "enum": [
            "decision",
            "llm_generation",
            "outbox_message",
            "evidence_addition",
            "link_dispute",
            "terms_snapshot",
            "inspection",
            "catalog_task",
            "coupon_rule",
            "coupon_rule_application",
            "simulator_assumptions"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "entity_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Entity Id",
          "type": "string"
        },
        "return_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Return Id"
        },
        "decision_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decision Id"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 3,
              "pattern": "\\S[\\s\\S]+\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionAuditState"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before"
        },
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionAuditState"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "After"
        },
        "rules_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rules Version"
        },
        "model_versions": {
          "anyOf": [
            {
              "additionalProperties": {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Versions"
        },
        "assumptions_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Assumptions Version"
        },
        "request_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Request Id"
        }
      },
      "required": [
        "entry_id",
        "at",
        "actor",
        "actor_role",
        "action",
        "entity_type",
        "entity_id",
        "return_id",
        "decision_id",
        "reason",
        "before",
        "after",
        "rules_version",
        "model_versions",
        "assumptions_version",
        "request_id"
      ],
      "title": "AuditEntry",
      "type": "object"
    },
    "ClaimView": {
      "additionalProperties": false,
      "description": "A diminished-value claim (art. 14(2)): only from confirmed observations and a rule.",
      "properties": {
        "inspection_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Inspection Id",
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/Metric"
        },
        "photo_evidence_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Photo Evidence Ids",
          "type": "array"
        },
        "confirmed_by": {
          "not": {
            "const": "system"
          },
          "pattern": "^[a-z][a-z0-9._-]{1,31}$",
          "title": "Confirmed By",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "inspection_id",
        "amount",
        "photo_evidence_ids",
        "confirmed_by",
        "rule_id"
      ],
      "title": "ClaimView",
      "type": "object"
    },
    "CouponRuleApplication": {
      "additionalProperties": false,
      "description": "The general coupon rule applied to one cluster (US-402, LEG-09): proposed with a\ndecision, confirmed by the person who approves it, always reversible, with the review date\nof that decision (US-607).\n\nin_force says whether the block applies to the linked accounts at as_of (the time the\napplication was served): confirmed, not reversed, and before its review date (UTC days). It\nlapses at the review date like the restriction that applied it. The API reverses it when the\nversion that applied it is lifted (DecisionResult.coupon_application) or superseded by a\nrecompute; a person reverses it on request (rectification). as_of and in_force are computed\nwhen served, not stored.",
      "properties": {
        "application_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Application Id",
          "type": "string"
        },
        "rule_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "cluster_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Cluster Id",
          "type": "string"
        },
        "decision_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Decision Id",
          "type": "string"
        },
        "affected_customer_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Customer Ids",
          "type": "array"
        },
        "state": {
          "enum": [
            "proposed",
            "confirmed",
            "reversed"
          ],
          "title": "State",
          "type": "string"
        },
        "proposed_at": {
          "format": "date-time",
          "title": "Proposed At",
          "type": "string"
        },
        "confirmed_by": {
          "anyOf": [
            {
              "not": {
                "const": "system"
              },
              "pattern": "^[a-z][a-z0-9._-]{1,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confirmed By"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confirmed At"
        },
        "review_at": {
          "format": "date",
          "title": "Review At",
          "type": "string"
        },
        "reversible": {
          "const": true,
          "default": true,
          "title": "Reversible",
          "type": "boolean"
        },
        "reversed_by": {
          "anyOf": [
            {
              "not": {
                "const": "system"
              },
              "pattern": "^[a-z][a-z0-9._-]{1,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reversed By"
        },
        "reversed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reversed At"
        },
        "reversal_reason": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 3,
              "pattern": "\\S[\\s\\S]+\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reversal Reason"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "in_force": {
          "title": "In Force",
          "type": "boolean"
        }
      },
      "required": [
        "application_id",
        "rule_version",
        "cluster_id",
        "decision_id",
        "affected_customer_ids",
        "state",
        "proposed_at",
        "confirmed_by",
        "confirmed_at",
        "review_at",
        "reversible",
        "reversed_by",
        "reversed_at",
        "reversal_reason",
        "as_of",
        "in_force"
      ],
      "title": "CouponRuleApplication",
      "type": "object"
    },
    "CouponRuleRef": {
      "additionalProperties": false,
      "description": "A proposed or confirmed application of the general coupon rule to a cluster (US-402).",
      "properties": {
        "rule_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "application_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Application Id",
          "type": "string"
        },
        "cluster_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Cluster Id",
          "type": "string"
        },
        "affected_customer_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Customer Ids",
          "type": "array"
        },
        "confirmed_by": {
          "anyOf": [
            {
              "not": {
                "const": "system"
              },
              "pattern": "^[a-z][a-z0-9._-]{1,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confirmed By"
        }
      },
      "required": [
        "rule_version",
        "application_id",
        "cluster_id",
        "affected_customer_ids",
        "confirmed_by"
      ],
      "title": "CouponRuleRef",
      "type": "object"
    },
    "DecisionAuditState": {
      "additionalProperties": false,
      "description": "The before and after of an audit entry about a decision version (entity_type decision):\nwhat changed, with the id that serves the whole version (GET /api/decisions/{decision_id}).",
      "properties": {
        "decision_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Decision Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "state": {
          "enum": [
            "proposed",
            "approved",
            "overridden",
            "rejected"
          ],
          "title": "State",
          "type": "string"
        },
        "quadrant": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quadrant"
            },
            {
              "type": "null"
            }
          ]
        },
        "risk": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ]
        },
        "lever_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 3,
            "type": "string"
          },
          "title": "Lever Ids",
          "type": "array"
        },
        "requires_approval": {
          "title": "Requires Approval",
          "type": "boolean"
        },
        "review_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Review At"
        },
        "approver": {
          "anyOf": [
            {
              "not": {
                "const": "system"
              },
              "pattern": "^[a-z][a-z0-9._-]{1,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approver"
        },
        "override_category": {
          "anyOf": [
            {
              "enum": [
                "evidence_disagreement",
                "customer_context",
                "linked_accounts_explained",
                "policy_exception",
                "periodic_review",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Override Category"
        },
        "coupon_application_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Coupon Application Id"
        }
      },
      "required": [
        "decision_id",
        "version",
        "state",
        "quadrant",
        "risk",
        "lever_ids",
        "requires_approval",
        "review_at",
        "approver",
        "override_category",
        "coupon_application_id"
      ],
      "title": "DecisionAuditState",
      "type": "object"
    },
    "DecisionInputs": {
      "additionalProperties": false,
      "description": "The inputs given to policy.engine.decide, kept for audit (US-604) and re-runnable: the\nreturn request (with order_id and customer_id), the scores, the terms and the thresholds.\nprovenance covers the plain numbers of the inputs (risk, value_eur, thresholds): the scores\nat decision time, stored with the version so an earlier one is served as it was (rule 11).",
      "properties": {
        "order_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Order Id",
          "type": "string"
        },
        "customer_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Customer Id",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/ReturnReason"
        },
        "delivered_on": {
          "format": "date",
          "title": "Delivered On",
          "type": "string"
        },
        "notice_on": {
          "format": "date",
          "title": "Notice On",
          "type": "string"
        },
        "order_terms": {
          "$ref": "#/$defs/Terms"
        },
        "base_terms": {
          "$ref": "#/$defs/Terms"
        },
        "risk": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Risk"
        },
        "value_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value Eur"
        },
        "evidence_quality": {
          "$ref": "#/$defs/EvidenceQuality"
        },
        "cluster_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cluster Id"
        },
        "thresholds": {
          "$ref": "#/$defs/DecisionThresholds"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "order_id",
        "customer_id",
        "reason",
        "delivered_on",
        "notice_on",
        "order_terms",
        "base_terms",
        "risk",
        "value_eur",
        "evidence_quality",
        "cluster_id",
        "thresholds",
        "provenance"
      ],
      "title": "DecisionInputs",
      "type": "object"
    },
    "DecisionThresholds": {
      "additionalProperties": false,
      "properties": {
        "risk": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Risk",
          "type": "number"
        },
        "value_eur": {
          "title": "Value Eur",
          "type": "number"
        }
      },
      "required": [
        "risk",
        "value_eur"
      ],
      "title": "DecisionThresholds",
      "type": "object"
    },
    "DecisionView": {
      "additionalProperties": false,
      "description": "A decision version: the engine's proposal and the human outcome (spec 8.6, US-303/306).\n\nlevers are the levers of the current state: the proposal while proposed or approved, the\noperator's levers when overridden, none when rejected. requires_approval and review_at refer\nto them: a restriction needs a person and has a review date, and nothing else has one.\n\nin_force says whether the levers apply to future orders at as_of (the time the view was\nserved): approved, overridden, or proposed without a need for approval; never once a later\nversion supersedes this one; never from the review date on, counted in UTC days (US-607: a\nrestriction lapses unless a person renews it).\n\nA version created by a review (trigger review) is policy.engine.decide() on the latest\nscores at the day of the review (inputs, decided_on, quadrant, proposed_levers), with the\nperson's outcome: action lift overrides it to the standard levers; action renew approves the\nfresh restriction, with a new review date.\n\nEvery view passes policy.legal_guard under to_policy_decision (ADR-15 section 8).",
      "properties": {
        "decision_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Decision Id",
          "type": "string"
        },
        "return_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Return Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "revision_trigger": {
          "enum": [
            "initial",
            "evidence_added",
            "link_disputed",
            "review"
          ],
          "title": "Revision Trigger",
          "type": "string"
        },
        "supersedes": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supersedes"
        },
        "superseded_by": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Superseded By"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "decided_on": {
          "format": "date",
          "title": "Decided On",
          "type": "string"
        },
        "state": {
          "enum": [
