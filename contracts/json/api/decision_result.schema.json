            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              },
              "scope": {
                "const": "current_order"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "priority_size_exchange"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              },
              "scope": {
                "const": "all_orders"
