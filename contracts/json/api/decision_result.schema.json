            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              },
              "scope": {
                "const": "future_orders"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "instant_refund"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              },
              "scope": {
                "const": "future_orders"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "free_size_exchange"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              },
              "scope": {
                "const": "all_orders"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "coupons_enabled"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              },
              "scope": {
                "const": "future_orders"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "cluster_coupons_disabled"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              },
              "scope": {
                "const": "future_orders_cluster"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "transparency_notice"
              }
