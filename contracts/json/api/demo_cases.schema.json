{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "CartLine": {
      "additionalProperties": false,
      "properties": {
        "variant_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Variant Id",
          "type": "string"
        },
        "size": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Size",
          "type": "string"
        },
        "quantity": {
          "default": 1,
          "maximum": 5,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        }
      },
      "required": [
        "variant_id",
        "size"
      ],
      "title": "CartLine",
      "type": "object"
    },
    "CheckoutEvaluateRequest": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Customer Id",
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/CartLine"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Lines",
          "type": "array"
        },
        "coupon_code": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coupon Code"
        }
      },
      "required": [
        "customer_id",
        "lines"
      ],
      "title": "CheckoutEvaluateRequest",
      "type": "object"
    },
    "DemoCart": {
      "additionalProperties": false,
      "description": "A checkout cart of the demo: Giulia's sizes, and an account of the Marco ring.",
      "properties": {
        "key": {
          "enum": [
            "giulia",
            "ring"
          ],
          "title": "Key",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/CheckoutEvaluateRequest"
        }
      },
      "required": [
        "key",
        "request"
      ],
      "title": "DemoCart",
      "type": "object"
    },
    "DemoCase": {
      "additionalProperties": false,
      "description": "A golden case of the demo with its live ids, found by the reset from the golden customer\nids of the store (pipeline.generator.golden): the open return of the customer, the version\nthe reset decided and the cluster the engine was given.",
      "properties": {
        "key": {
          "enum": [
            "giulia",
            "marco",
            "rossi",
            "rossi_card",
            "elena",
            "insufficient"
          ],
          "title": "Key",
          "type": "string"
        },
        "return_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Return Id",
          "type": "string"
        },
        "customer_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Customer Id",
          "type": "string"
        },
        "decision_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Decision Id",
          "type": "string"
        },
        "cluster_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cluster Id"
        }
      },
      "required": [
        "key",
        "return_id",
        "customer_id",
        "decision_id",
        "cluster_id"
      ],
      "title": "DemoCase",
      "type": "object"
    },
    "DemoDispute": {
      "additionalProperties": false,
      "description": "A link whose dispute changes the cluster of the case named (US-310): the customer's\ncluster has cluster_size_before accounts, and cluster_size_after once the link is out (1:\nthe account alone). changes_decision (1.6.0) says whether the recompute the dispute makes\nchanges the engine's quadrant or levers of the case (a dry run at the reset, which prefers\nsuch a link): false, the UI says \"decision unchanged\".",
      "properties": {
        "link_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Link Id",
          "type": "string"
        },
        "return_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Return Id",
          "type": "string"
        },
        "decision_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Decision Id",
          "type": "string"
        },
        "cluster_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Cluster Id",
          "type": "string"
        },
        "cluster_size_before": {
          "minimum": 2,
          "title": "Cluster Size Before",
          "type": "integer"
        },
        "cluster_size_after": {
          "minimum": 1,
          "title": "Cluster Size After",
          "type": "integer"
        },
        "changes_decision": {
          "title": "Changes Decision",
          "type": "boolean"
        }
      },
      "required": [
        "link_id",
        "return_id",
        "decision_id",
        "cluster_id",
        "cluster_size_before",
        "cluster_size_after",
        "changes_decision"
      ],
      "title": "DemoDispute",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a number comes from: origin, period and nature (same fields as contracts.io).",
      "properties": {
        "origin": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "nature": {
          "enum": [
            "real",
            "synthetic",
            "simulated"
          ],
          "title": "Nature",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "period_start",
        "period_end",
        "nature"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "GET /api/demo/cases: the ids the UI's demo flows open, built by the reset (US-903). A\ngolden case the store does not hold (a small --scale) is missing from the list.",
  "properties": {
    "snapshot_as_of": {
      "format": "date-time",
      "title": "Snapshot As Of",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/DemoCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "dispute": {
      "anyOf": [
        {
          "$ref": "#/$defs/DemoDispute"
        },
        {
          "type": "null"
        }
      ]
    },
    "carts": {
      "items": {
        "$ref": "#/$defs/DemoCart"
      },
      "title": "Carts",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "snapshot_as_of",
    "as_of",
    "cases",
    "dispute",
    "carts",
    "provenance"
  ],
  "title": "DemoCasesResponse",
  "type": "object"
}
