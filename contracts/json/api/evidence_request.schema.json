{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "additionalProperties": false,
  "description": "Favourable evidence added by the operator (US-310). Kinds that explain links name them:\nthe explained links leave the cluster features and the case is recomputed.",
  "properties": {
    "decision_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Decision Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "household_members",
        "shared_payment_explained",
        "collective_address",
        "customer_contact",
        "other"
      ],
      "title": "Kind",
      "type": "string"
    },
    "note": {
      "maxLength": 1000,
      "minLength": 3,
      "title": "Note",
      "type": "string"
    },
    "target_link_ids": {
      "items": {
        "maxLength": 96,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
        "type": "string"
      },
      "title": "Target Link Ids",
      "type": "array"
    },
    "author": {
      "not": {
        "const": "system"
      },
      "pattern": "^[a-z][a-z0-9._-]{1,31}$",
      "title": "Author",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "kind",
    "note",
    "author"
  ],
  "title": "EvidenceRequest",
  "type": "object"
}
