{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "FairnessDimensionReport": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "new_customers",
            "households",
            "low_data",
            "tenure",
            "price_band",
            "category"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/FairnessSegment"
          },
          "minItems": 2,
          "title": "Segments",
          "type": "array"
        },
        "max_gap": {
          "$ref": "#/$defs/Metric"
        },
        "warning": {
          "title": "Warning",
          "type": "boolean"
        }
      },
      "required": [
        "dimension",
        "segments",
        "max_gap",
        "warning"
      ],
      "title": "FairnessDimensionReport",
      "type": "object"
    },
    "FairnessSegment": {
      "additionalProperties": false,
      "properties": {
        "segment": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Segment",
          "type": "string"
        },
        "false_positive_rate": {
          "$ref": "#/$defs/Metric"
        },
        "customers": {
          "$ref": "#/$defs/Metric"
        }
      },
      "required": [
        "segment",
        "false_positive_rate",
        "customers"
      ],
      "title": "FairnessSegment",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "A figure shown in the UI: its value, its unit and where it comes from.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "eur",
            "usd",
            "count",
            "expected_count",
            "ratio",
            "probability",
            "percent",
            "percentage_points",
            "z_score",
            "score",
            "days",
            "seconds",
            "milliseconds",
            "tokens_per_second",
            "gib",
            "watts"
          ],
          "title": "Unit",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "value",
        "unit",
        "provenance"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a number comes from: origin, period and nature (same fields as contracts.io).",
      "properties": {
        "origin": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "nature": {
          "enum": [
            "real",
            "synthetic",
            "simulated"
          ],
          "title": "Nature",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "period_start",
        "period_end",
        "nature"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "US-605, NFR-04: false positives by segment, with a warning above the gap threshold.",
  "properties": {
    "report_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Report Id",
      "type": "string"
    },
    "scenario": {
      "enum": [
        "main",
        "ood"
      ],
      "title": "Scenario",
      "type": "string"
    },
    "model_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Model Version",
      "type": "string"
    },
    "max_gap_threshold": {
      "$ref": "#/$defs/Metric"
    },
    "dimensions": {
      "items": {
        "$ref": "#/$defs/FairnessDimensionReport"
      },
      "minItems": 1,
      "title": "Dimensions",
      "type": "array"
    }
  },
  "required": [
    "report_id",
    "scenario",
    "model_version",
    "max_gap_threshold",
    "dimensions"
  ],
  "title": "FairnessResponse",
  "type": "object"
}
