{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "ChecklistSuggestion": {
      "additionalProperties": false,
      "description": "A candidate observation from the vision model: Ahmed confirms it (spec 8.8).",
      "properties": {
        "item": {
          "enum": [
            "tag_attached",
            "visible_damage",
            "photo_quality"
          ],
          "title": "Item",
          "type": "string"
        },
        "suggestion": {
          "enum": [
            "yes",
            "no",
            "not_observable"
          ],
          "title": "Suggestion",
          "type": "string"
        },
        "model_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Model Confidence",
          "type": "number"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Note"
        }
      },
      "required": [
        "item",
        "suggestion",
        "model_confidence",
        "note"
      ],
      "title": "ChecklistSuggestion",
      "type": "object"
    },
    "CompensationProposal": {
      "additionalProperties": false,
      "description": "A diminished-value proposal from an approved rule; it holds only if Ahmed confirms the\nobservations it rests on, and the amount is recomputed from the confirmed ones (US-502).",
      "properties": {
        "rule_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Rule Id",
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/Metric"
        },
        "basis": {
          "items": {
            "enum": [
              "tag_attached",
              "visible_damage",
              "photo_quality"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Basis",
          "type": "array"
        },
        "text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "amount",
        "basis",
        "text"
      ],
      "title": "CompensationProposal",
      "type": "object"
    },
    "ConfirmedObservation": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "enum": [
            "tag_attached",
            "visible_damage",
            "photo_quality"
          ],
          "title": "Item",
          "type": "string"
        },
        "observation": {
          "enum": [
            "yes",
            "no",
            "not_observable"
          ],
          "title": "Observation",
          "type": "string"
        }
      },
      "required": [
        "item",
        "observation"
      ],
      "title": "ConfirmedObservation",
      "type": "object"
    },
    "GenerationInfo": {
      "additionalProperties": false,
      "description": "How an LLM output was produced (spec 8.7, US-901 cached label): the path of llm.generate,\nthe model calls, the codes of llm.validator found on the way and, for the template, why.",
      "properties": {
        "generation_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Generation Id",
          "type": "string"
        },
        "generation_path": {
          "enum": [
            "model",
            "regenerated",
            "template"
          ],
          "title": "Generation Path",
          "type": "string"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "enum": [
                "decision_echo",
                "invalid_twice",
                "unavailable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fallback Reason"
        },
        "llm_mode": {
          "enum": [
            "vllm",
            "mock"
          ],
          "title": "Llm Mode",
          "type": "string"
        },
        "served_from": {
          "enum": [
            "live",
            "cached"
          ],
          "title": "Served From",
          "type": "string"
        },
        "model": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_calls": {
          "maximum": 2,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "validator_codes": {
          "items": {
            "enum": [
              "SCHEMA",
              "CASE_INVALID",
              "DECISION_ECHO",
              "TERMS_TOPIC",
              "UNKNOWN_FACT",
              "MISSING_FACT",
              "LABEL_MISMATCH",
              "UNGROUNDED_NUMBER",
              "BANNED_TERM",
              "SCRIPT",
              "SENTENCE_ID",
              "WRONG_LANGUAGE"
            ],
            "type": "string"
          },
          "title": "Validator Codes",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latency Ms"
        }
      },
      "required": [
        "generation_id",
        "generation_path",
        "fallback_reason",
        "llm_mode",
        "served_from",
        "model",
        "model_calls",
        "validator_codes",
        "created_at",
        "latency_ms"
      ],
      "title": "GenerationInfo",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "A figure shown in the UI: its value, its unit and where it comes from.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "eur",
            "usd",
            "count",
            "expected_count",
            "ratio",
            "probability",
            "percent",
            "percentage_points",
            "z_score",
            "score",
            "days",
            "seconds",
            "milliseconds",
            "tokens_per_second",
            "gib",
            "watts"
          ],
          "title": "Unit",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "value",
        "unit",
        "provenance"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Path": {
      "enum": [
        "withdrawal",
        "guarantee"
      ],
      "title": "Path",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a number comes from: origin, period and nature (same fields as contracts.io).",
      "properties": {
        "origin": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "nature": {
          "enum": [
            "real",
            "synthetic",
            "simulated"
          ],
          "title": "Nature",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "period_start",
        "period_end",
        "nature"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "inspection_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Inspection Id",
      "type": "string"
    },
    "return_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Return Id",
      "type": "string"
    },
    "decision_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Decision Id",
      "type": "string"
    },
    "path": {
      "$ref": "#/$defs/Path"
    },
    "inspector": {
      "not": {
        "const": "system"
      },
      "pattern": "^[a-z][a-z0-9._-]{1,31}$",
      "title": "Inspector",
      "type": "string"
    },
    "photo_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Photo Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "state": {
      "enum": [
        "awaiting_confirmation",
        "manual_review",
        "confirmed"
      ],
      "title": "State",
      "type": "string"
    },
    "checklist": {
      "items": {
        "$ref": "#/$defs/ChecklistSuggestion"
      },
      "title": "Checklist",
      "type": "array"
    },
    "confidence_is_calibrated": {
      "const": false,
      "default": false,
      "title": "Confidence Is Calibrated",
      "type": "boolean"
    },
    "manual_review_reason": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Manual Review Reason"
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompensationProposal"
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmed_observations": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ConfirmedObservation"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Confirmed Observations"
    },
    "confirmed_by": {
      "anyOf": [
        {
          "not": {
            "const": "system"
          },
          "pattern": "^[a-z][a-z0-9._-]{1,31}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Confirmed By"
    },
    "confirmed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Confirmed At"
    },
    "generation": {
      "$ref": "#/$defs/GenerationInfo"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "inspection_id",
    "return_id",
    "decision_id",
    "path",
    "inspector",
    "photo_id",
    "created_at",
    "state",
    "checklist",
    "confidence_is_calibrated",
    "manual_review_reason",
    "proposal",
    "confirmed_observations",
    "confirmed_by",
    "confirmed_at",
    "generation",
    "provenance"
  ],
  "title": "InspectionView",
  "type": "object"
}
