{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "AccountLink": {
      "additionalProperties": false,
      "description": "A link between two accounts (features/links, spec 8.3): kinds, dates and frequency. A link\nis a shared identifier, not a finding about who uses the accounts.",
      "properties": {
        "link_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Link Id",
          "type": "string"
        },
        "customer_a": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Customer A",
          "type": "string"
        },
        "customer_b": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Customer B",
          "type": "string"
        },
        "kinds": {
          "items": {
            "enum": [
              "card",
              "email",
              "device",
              "address",
              "phone",
              "ip_prefix"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Kinds",
          "type": "array"
        },
        "weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "weight_decayed": {
          "maximum": 1,
          "minimum": 0,
          "title": "Weight Decayed",
          "type": "number"
        },
        "first_shared_at": {
          "format": "date-time",
          "title": "First Shared At",
          "type": "string"
        },
        "last_shared_at": {
          "format": "date-time",
          "title": "Last Shared At",
          "type": "string"
        },
        "n_shared_events": {
          "minimum": 1,
          "title": "N Shared Events",
          "type": "integer"
        },
        "max_sharers": {
          "minimum": 2,
          "title": "Max Sharers",
          "type": "integer"
        },
        "disputed": {
          "title": "Disputed",
          "type": "boolean"
        },
        "dispute": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinkDisputeInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "explained_by_evidence_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Explained By Evidence Id"
        }
      },
      "required": [
        "link_id",
        "customer_a",
        "customer_b",
        "kinds",
        "weight",
        "weight_decayed",
        "first_shared_at",
        "last_shared_at",
        "n_shared_events",
        "max_sharers",
        "disputed",
        "dispute",
        "explained_by_evidence_id"
      ],
      "title": "AccountLink",
      "type": "object"
    },
    "CaseSnapshot": {
      "additionalProperties": false,
      "description": "The figures that change when a case is recomputed: shown before and after (US-310).",
      "properties": {
        "decision_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Decision Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "quadrant": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quadrant"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_quality": {
          "$ref": "#/$defs/EvidenceQuality"
        },
        "risk": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ]
        },
        "top_factors": {
          "items": {
            "$ref": "#/$defs/ScoreContribution"
          },
          "maxItems": 3,
          "title": "Top Factors",
          "type": "array"
        },
        "lever_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 3,
            "type": "string"
          },
          "title": "Lever Ids",
          "type": "array"
        },
        "requires_approval": {
          "title": "Requires Approval",
          "type": "boolean"
        },
        "cluster_size": {
          "anyOf": [
            {
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cluster Size"
        },
        "active_links": {
          "minimum": 0,
          "title": "Active Links",
          "type": "integer"
        }
      },
      "required": [
        "decision_id",
        "version",
        "quadrant",
        "evidence_quality",
        "risk",
        "top_factors",
        "lever_ids",
        "requires_approval",
        "cluster_size",
        "active_links"
      ],
      "title": "CaseSnapshot",
      "type": "object"
    },
    "ClaimView": {
      "additionalProperties": false,
      "description": "A diminished-value claim (art. 14(2)): only from confirmed observations and a rule.",
      "properties": {
        "inspection_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Inspection Id",
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/Metric"
        },
        "photo_evidence_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Photo Evidence Ids",
          "type": "array"
        },
        "confirmed_by": {
          "not": {
            "const": "system"
          },
          "pattern": "^[a-z][a-z0-9._-]{1,31}$",
          "title": "Confirmed By",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "inspection_id",
        "amount",
        "photo_evidence_ids",
        "confirmed_by",
        "rule_id"
      ],
      "title": "ClaimView",
      "type": "object"
    },
    "CouponRuleRef": {
      "additionalProperties": false,
      "description": "A proposed or confirmed application of the general coupon rule to a cluster (US-402).",
      "properties": {
        "rule_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "application_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Application Id",
          "type": "string"
        },
        "cluster_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Cluster Id",
          "type": "string"
        },
        "affected_customer_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Affected Customer Ids",
          "type": "array"
        },
        "confirmed_by": {
          "anyOf": [
            {
              "not": {
                "const": "system"
              },
              "pattern": "^[a-z][a-z0-9._-]{1,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confirmed By"
        }
      },
      "required": [
        "rule_version",
        "application_id",
        "cluster_id",
        "affected_customer_ids",
        "confirmed_by"
      ],
      "title": "CouponRuleRef",
      "type": "object"
    },
    "CustomerMessageView": {
      "additionalProperties": false,
      "description": "A customer message: connective text from the LLM (placeholders only), template fields from\ncode, the fixed legal clause appended by code, and the text the customer receives.",
      "properties": {
        "lang": {
          "enum": [
            "it",
            "en"
          ],
          "title": "Lang",
          "type": "string"
        },
        "connective_text": {
          "maxLength": 900,
          "minLength": 1,
          "title": "Connective Text",
          "type": "string"
        },
        "fields": {
          "$ref": "#/$defs/TemplateFields"
        },
        "legal_clause_kind": {
          "anyOf": [
            {
              "enum": [
                "withdrawal",
                "guarantee"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Legal Clause Kind"
        },
        "rendered_text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Rendered Text",
          "type": "string"
        }
      },
      "required": [
        "lang",
        "connective_text",
        "fields",
        "legal_clause_kind",
        "rendered_text"
      ],
      "title": "CustomerMessageView",
      "type": "object"
    },
    "DecisionEchoView": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/Path"
        },
        "quadrant": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quadrant"
            },
            {
              "type": "null"
            }
          ]
        },
        "lever_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 3,
            "type": "string"
          },
          "title": "Lever Ids",
          "type": "array"
        }
      },
      "required": [
        "path",
        "quadrant",
        "lever_ids"
      ],
      "title": "DecisionEchoView",
      "type": "object"
    },
    "DecisionInputs": {
      "additionalProperties": false,
      "description": "The inputs given to policy.engine.decide, kept for audit (US-604) and re-runnable: the\nreturn request (with order_id and customer_id), the scores, the terms and the thresholds.",
      "properties": {
        "order_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Order Id",
          "type": "string"
        },
        "customer_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Customer Id",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/ReturnReason"
        },
        "delivered_on": {
          "format": "date",
          "title": "Delivered On",
          "type": "string"
        },
        "notice_on": {
          "format": "date",
          "title": "Notice On",
          "type": "string"
        },
        "order_terms": {
          "$ref": "#/$defs/Terms"
        },
        "base_terms": {
          "$ref": "#/$defs/Terms"
        },
        "risk": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Risk"
        },
        "value_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value Eur"
        },
        "evidence_quality": {
          "$ref": "#/$defs/EvidenceQuality"
        },
        "cluster_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cluster Id"
        },
        "thresholds": {
          "$ref": "#/$defs/DecisionThresholds"
        }
      },
      "required": [
        "order_id",
        "customer_id",
        "reason",
        "delivered_on",
        "notice_on",
        "order_terms",
        "base_terms",
        "risk",
        "value_eur",
        "evidence_quality",
        "cluster_id",
        "thresholds"
      ],
      "title": "DecisionInputs",
      "type": "object"
    },
    "DecisionThresholds": {
      "additionalProperties": false,
      "properties": {
        "risk": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Risk",
          "type": "number"
        },
        "value_eur": {
          "title": "Value Eur",
          "type": "number"
        }
      },
      "required": [
        "risk",
        "value_eur"
      ],
      "title": "DecisionThresholds",
      "type": "object"
    },
    "DecisionView": {
      "additionalProperties": false,
      "description": "A decision version: the engine's proposal and the human outcome (spec 8.6, US-303/306).\n\nlevers are the levers of the current state: the proposal while proposed or approved, the\noperator's levers when overridden, none when rejected. requires_approval and review_at refer\nto them: a restriction needs a person and has a review date, and nothing else has one.\n\nin_force says whether the levers apply to future orders at as_of (the time the view was\nserved): approved, overridden, or proposed without a need for approval; never once a later\nversion supersedes this one; never from the review date on (US-607: a restriction lapses\nunless a person renews it with a new decision). A version created by a review (trigger\nreview, action lift) is overridden to the standard levers.\n\nEvery view passes policy.legal_guard under to_policy_decision (ADR-15 section 8).",
      "properties": {
        "decision_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Decision Id",
          "type": "string"
        },
        "return_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Return Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "revision_trigger": {
          "enum": [
            "initial",
            "evidence_added",
            "link_disputed",
            "scores_refreshed",
            "review"
          ],
          "title": "Revision Trigger",
          "type": "string"
        },
        "supersedes": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supersedes"
        },
        "superseded_by": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Superseded By"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "decided_on": {
          "format": "date",
          "title": "Decided On",
          "type": "string"
        },
        "state": {
          "enum": [
            "proposed",
            "approved",
            "overridden",
            "rejected"
          ],
          "title": "State",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/Path"
        },
        "evidence_quality": {
          "$ref": "#/$defs/EvidenceQuality"
        },
        "quadrant": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quadrant"
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_evidence": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "proposed_levers": {
          "items": {
            "$ref": "#/$defs/Lever"
          },
          "title": "Proposed Levers",
          "type": "array"
        },
        "levers": {
          "items": {
            "$ref": "#/$defs/Lever"
          },
          "title": "Levers",
          "type": "array"
        },
        "lever_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 3,
            "type": "string"
          },
          "title": "Lever Ids",
          "type": "array"
        },
        "requires_approval": {
          "title": "Requires Approval",
          "type": "boolean"
        },
        "in_force": {
          "title": "In Force",
          "type": "boolean"
        },
        "current_return_terms": {
          "$ref": "#/$defs/Terms"
        },
        "future_terms": {
          "$ref": "#/$defs/Terms"
        },
        "refund_due_by": {
          "format": "date",
          "title": "Refund Due By",
          "type": "string"
        },
        "review_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Review At"
        },
        "approver": {
          "anyOf": [
            {
              "not": {
                "const": "system"
              },
              "pattern": "^[a-z][a-z0-9._-]{1,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approver"
        },
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Approved At"
        },
        "override_reason": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 3,
              "pattern": "\\S[\\s\\S]+\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Override Reason"
        },
        "override_category": {
          "anyOf": [
            {
              "enum": [
                "evidence_disagreement",
                "customer_context",
                "linked_accounts_explained",
                "policy_exception",
                "periodic_review",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Override Category"
        },
        "coupon_rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/CouponRuleRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "diminished_value_claim": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClaimView"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "$ref": "#/$defs/DecisionInputs"
        },
        "rules_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Rules Version",
          "type": "string"
        },
        "model_versions": {
          "additionalProperties": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "title": "Model Versions",
          "type": "object"
        },
        "assumptions_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Assumptions Version",
          "type": "string"
        },
        "generation_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generation Id"
        }
      },
      "required": [
        "decision_id",
        "return_id",
        "version",
        "revision_trigger",
        "supersedes",
        "superseded_by",
        "created_at",
        "as_of",
        "decided_on",
        "state",
        "path",
        "evidence_quality",
        "quadrant",
        "missing_evidence",
        "proposed_levers",
        "levers",
        "lever_ids",
        "requires_approval",
        "in_force",
        "current_return_terms",
        "future_terms",
        "refund_due_by",
        "review_at",
        "approver",
        "approved_at",
        "override_reason",
        "override_category",
        "coupon_rule",
        "diminished_value_claim",
        "inputs",
        "rules_version",
        "model_versions",
        "assumptions_version",
        "generation_id"
      ],
      "title": "DecisionView",
      "type": "object"
    },
    "DraftView": {
      "additionalProperties": false,
      "description": "The explanation and messages drafted for a decision (US-304, US-305).",
      "properties": {
        "generation": {
          "$ref": "#/$defs/GenerationInfo"
        },
        "tone": {
          "enum": [
            "neutral",
            "warm",
            "formal"
          ],
          "title": "Tone",
          "type": "string"
        },
        "decision_echo": {
          "$ref": "#/$defs/DecisionEchoView"
        },
        "explanation": {
          "items": {
            "$ref": "#/$defs/ExplanationStatement"
          },
          "minItems": 1,
          "title": "Explanation",
          "type": "array"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/CustomerMessageView"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Messages",
          "type": "array"
        }
      },
      "required": [
        "generation",
        "tone",
        "decision_echo",
        "explanation",
        "messages"
      ],
      "title": "DraftView",
      "type": "object"
    },
    "EvidenceQuality": {
      "enum": [
        "sufficient",
        "insufficient"
      ],
      "title": "EvidenceQuality",
      "type": "string"
    },
    "ExplanationStatement": {
      "additionalProperties": false,
      "description": "A statement of the operator explanation: observed data, a score contribution or a\nhypothesis to verify (US-305). A statement whose text has a digit names the entity, the\nmetric, the value and the period it cites, and the value appears in the text.",
      "properties": {
        "label": {
          "enum": [
            "OBSERVED",
            "SCORE",
            "HYPOTHESIS"
          ],
          "title": "Label",
          "type": "string"
        },
        "text": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "entity": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
