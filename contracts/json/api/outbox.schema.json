{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "Metric": {
      "additionalProperties": false,
      "description": "A figure shown in the UI: its value, its unit and where it comes from.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "eur",
            "usd",
            "count",
            "expected_count",
            "ratio",
            "probability",
            "percent",
            "percentage_points",
            "z_score",
            "score",
            "days",
            "seconds",
            "milliseconds",
            "tokens_per_second",
            "gib",
            "watts"
          ],
          "title": "Unit",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "value",
        "unit",
        "provenance"
      ],
      "title": "Metric",
      "type": "object"
    },
    "OutboxMessage": {
      "additionalProperties": false,
      "description": "A message in the simulated outbox (spec 4: no real email), sent after a person acted: the\nphrasebook ids, the template fields of its language, the refund the {amount} field states\n(null when the refund amount is not known), and the body llm.phrasebook.render_selection\ncomposed for the decision acted on, ending with the fixed legal clause it requires. The\nmodels that hold the decision check the body against it (check_outbox_message).",
      "properties": {
        "message_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Message Id",
          "type": "string"
        },
        "return_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Return Id",
          "type": "string"
        },
        "decision_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Decision Id",
          "type": "string"
        },
        "customer_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Customer Id",
          "type": "string"
        },
        "lang": {
          "enum": [
            "it",
            "en"
          ],
          "title": "Lang",
          "type": "string"
        },
        "subject": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "sentence_ids": {
          "items": {
            "enum": [
              "OPEN_THANKS",
              "OPEN_MESSAGE",
              "OPEN_CHOICE",
              "OPEN_SORRY_FIT",
              "OPEN_SORRY_ITEM",
              "HELP_SIZE",
              "HELP_ADVICE",
              "CONTACT_REPLY",
              "CONTACT_TEAM",
              "INFO_TERMS",
              "GUARANTEE_CARE",
              "GUARANTEE_PHOTO",
              "THANKS_FEEDBACK",
              "CLOSE_REGARDS",
              "CLOSE_VALUED",
              "CLOSE_HAPPY",
              "CLOSE_DAY",
              "CLOSE_SOON",
              "CLOSE_PATIENCE"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Sentence Ids",
          "type": "array"
        },
        "fields": {
          "$ref": "#/$defs/TemplateFields"
        },
        "refund": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ]
        },
        "body": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "legal_clause_kind": {
          "anyOf": [
            {
              "enum": [
                "withdrawal",
                "guarantee"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Legal Clause Kind"
        },
        "generation_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generation Id"
        },
        "status": {
          "enum": [
            "queued",
            "sent_simulated"
          ],
          "title": "Status",
          "type": "string"
        },
        "created_by": {
          "not": {
            "const": "system"
          },
          "pattern": "^[a-z][a-z0-9._-]{1,31}$",
          "title": "Created By",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "return_id",
        "decision_id",
        "customer_id",
        "lang",
        "subject",
        "sentence_ids",
        "fields",
        "refund",
        "body",
        "legal_clause_kind",
        "generation_id",
        "status",
        "created_by",
        "created_at"
      ],
      "title": "OutboxMessage",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a number comes from: origin, period and nature (same fields as contracts.io).",
      "properties": {
        "origin": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "nature": {
          "enum": [
            "real",
            "synthetic",
            "simulated"
          ],
          "title": "Nature",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "period_start",
        "period_end",
        "nature"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "TemplateFields": {
      "additionalProperties": false,
      "description": "The values code fills into the placeholders of one language (ADR-08, rule 10):\nllm.messages.template_fields of the decision. A placeholder the decision does not have\n({amount} without a known refund, {terms} when the future terms do not change) is null.",
      "properties": {
        "terms": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Terms"
        },
        "amount": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount"
        },
        "deadline": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deadline"
        }
      },
      "required": [
        "terms",
        "amount",
        "deadline"
      ],
      "title": "TemplateFields",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/OutboxMessage"
      },
      "title": "Items",
      "type": "array"
    },
    "total": {
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "total"
  ],
  "title": "OutboxResponse",
  "type": "object"
}
