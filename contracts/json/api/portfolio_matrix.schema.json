{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "EvidenceQuality": {
      "enum": [
        "sufficient",
        "insufficient"
      ],
      "title": "EvidenceQuality",
      "type": "string"
    },
    "MatrixPoint": {
      "additionalProperties": false,
      "description": "One scored customer: what the browser simulator needs to move the thresholds (ADR-04).\nWith insufficient evidence there is no risk and no quadrant: the point stays outside the\nmatrix (US-307).",
      "properties": {
        "customer_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Customer Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Display Name"
        },
        "risk": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Risk"
        },
        "value_eur": {
          "title": "Value Eur",
          "type": "number"
        },
        "evidence_quality": {
          "$ref": "#/$defs/EvidenceQuality"
        },
        "quadrant": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quadrant"
            },
            {
              "type": "null"
            }
          ]
        },
        "cluster_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cluster Id"
        },
        "returns_12m": {
          "minimum": 0,
          "title": "Returns 12M",
          "type": "integer"
        },
        "welcome_coupons": {
          "minimum": 0,
          "title": "Welcome Coupons",
          "type": "integer"
        }
      },
      "required": [
        "customer_id",
        "display_name",
        "risk",
        "value_eur",
        "evidence_quality",
        "quadrant",
        "cluster_id",
        "returns_12m",
        "welcome_coupons"
      ],
      "title": "MatrixPoint",
      "type": "object"
    },
    "MatrixThresholds": {
      "additionalProperties": false,
      "properties": {
        "risk": {
          "$ref": "#/$defs/Metric"
        },
        "value_eur": {
          "$ref": "#/$defs/Metric"
        },
        "risk_basis": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Risk Basis",
          "type": "string"
        },
        "value_basis": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Value Basis",
          "type": "string"
        }
      },
      "required": [
        "risk",
        "value_eur",
        "risk_basis",
        "value_basis"
      ],
      "title": "MatrixThresholds",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "A figure shown in the UI: its value, its unit and where it comes from.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "eur",
            "usd",
            "count",
            "expected_count",
            "ratio",
            "probability",
            "percent",
            "percentage_points",
            "z_score",
            "score",
            "days",
            "seconds",
            "milliseconds",
            "tokens_per_second",
            "gib",
            "watts"
          ],
          "title": "Unit",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "value",
        "unit",
        "provenance"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a number comes from: origin, period and nature (same fields as contracts.io).",
      "properties": {
        "origin": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "nature": {
          "enum": [
            "real",
            "synthetic",
            "simulated"
          ],
          "title": "Nature",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "period_start",
        "period_end",
        "nature"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Quadrant": {
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "Q4"
      ],
      "title": "Quadrant",
      "type": "string"
    },
    "QuadrantSummary": {
      "additionalProperties": false,
      "properties": {
        "quadrant": {
          "$ref": "#/$defs/Quadrant"
        },
        "customers": {
          "$ref": "#/$defs/Metric"
        },
        "value_eur": {
          "$ref": "#/$defs/Metric"
        },
        "returns_12m": {
          "$ref": "#/$defs/Metric"
        }
      },
      "required": [
        "quadrant",
        "customers",
        "value_eur",
        "returns_12m"
      ],
      "title": "QuadrantSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "GET /api/portfolio/matrix: every scored customer, the thresholds and the quadrant totals.\nThe quadrant totals are computed on the points (a validator checks it).",
  "properties": {
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "thresholds": {
      "$ref": "#/$defs/MatrixThresholds"
    },
    "quadrants": {
      "items": {
        "$ref": "#/$defs/QuadrantSummary"
      },
      "title": "Quadrants",
      "type": "array"
    },
    "insufficient_evidence": {
      "$ref": "#/$defs/Metric"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/MatrixPoint"
      },
      "title": "Points",
      "type": "array"
    },
    "points_provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "legend": {
      "const": "Customer value orients benefits and service. It is never a signal of abuse and never feeds the risk score.",
      "default": "Customer value orients benefits and service. It is never a signal of abuse and never feeds the risk score.",
      "title": "Legend",
      "type": "string"
    }
  },
  "required": [
    "as_of",
    "thresholds",
    "quadrants",
    "insufficient_evidence",
    "points",
    "points_provenance",
    "legend"
  ],
  "title": "PortfolioMatrix",
  "type": "object"
}
