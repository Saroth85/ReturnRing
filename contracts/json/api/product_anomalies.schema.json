{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "AnomalyThresholds": {
      "additionalProperties": false,
      "properties": {
        "z": {
          "exclusiveMinimum": 0,
          "title": "Z",
          "type": "number"
        },
        "min_sales": {
          "minimum": 1,
          "title": "Min Sales",
          "type": "integer"
        }
      },
      "required": [
        "z",
        "min_sales"
      ],
      "title": "AnomalyThresholds",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "A figure shown in the UI: its value, its unit and where it comes from.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "eur",
            "usd",
            "count",
            "expected_count",
            "ratio",
            "probability",
            "percent",
            "percentage_points",
            "z_score",
            "score",
            "days",
            "seconds",
            "milliseconds",
            "tokens_per_second",
            "gib",
            "watts"
          ],
          "title": "Unit",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "value",
        "unit",
        "provenance"
      ],
      "title": "Metric",
      "type": "object"
    },
    "ProductAnomaly": {
      "additionalProperties": false,
      "description": "Returns of a variant for one reason in one week above the category baseline (spec 8.9).",
      "properties": {
        "anomaly_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Anomaly Id",
          "type": "string"
        },
        "variant_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Variant Id",
          "type": "string"
        },
        "product_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Product Id",
          "type": "string"
        },
        "category": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "brand": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Brand"
        },
        "reason": {
          "$ref": "#/$defs/ReturnReason"
        },
        "week": {
          "format": "date",
          "title": "Week",
          "type": "string"
        },
        "observed": {
          "$ref": "#/$defs/Metric"
        },
        "expected": {
          "$ref": "#/$defs/Metric"
        },
        "z": {
          "$ref": "#/$defs/Metric"
        },
        "sales": {
          "$ref": "#/$defs/Metric"
        },
        "status": {
          "enum": [
            "open",
            "task_opened",
            "resolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "catalog_task_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Catalog Task Id"
        },
        "return_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
            "type": "string"
          },
          "title": "Return Ids",
          "type": "array"
        },
        "queued_return_ids": {
          "items": {
            "maxLength": 96,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
            "type": "string"
          },
          "title": "Queued Return Ids",
          "type": "array"
        },
        "trend": {
          "items": {
            "$ref": "#/$defs/WeeklyReturnRate"
          },
          "title": "Trend",
          "type": "array"
        }
      },
      "required": [
        "anomaly_id",
        "variant_id",
        "product_id",
        "category",
        "brand",
        "reason",
        "week",
        "observed",
        "expected",
        "z",
        "sales",
        "status",
        "catalog_task_id",
        "return_ids",
        "queued_return_ids",
        "trend"
      ],
      "title": "ProductAnomaly",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a number comes from: origin, period and nature (same fields as contracts.io).",
      "properties": {
        "origin": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "nature": {
          "enum": [
            "real",
            "synthetic",
            "simulated"
          ],
          "title": "Nature",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "period_start",
        "period_end",
        "nature"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ReturnReason": {
      "enum": [
        "size",
        "changed_mind",
        "not_as_expected",
        "defective",
        "damaged_in_shipping",
        "wrong_item",
        "not_as_described",
        "other"
      ],
      "title": "ReturnReason",
      "type": "string"
    },
    "WeeklyReturnRate": {
      "additionalProperties": false,
      "properties": {
        "week": {
          "format": "date",
          "title": "Week",
          "type": "string"
        },
        "sales": {
          "minimum": 0,
          "title": "Sales",
          "type": "integer"
        },
        "returns": {
          "minimum": 0,
          "title": "Returns",
          "type": "integer"
        },
        "return_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Return Rate",
          "type": "number"
        }
      },
      "required": [
        "week",
        "sales",
        "returns",
        "return_rate"
      ],
      "title": "WeeklyReturnRate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "thresholds": {
      "$ref": "#/$defs/AnomalyThresholds"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ProductAnomaly"
      },
      "title": "Items",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "as_of",
    "thresholds",
    "items",
    "provenance"
  ],
  "title": "ProductAnomaliesResponse",
  "type": "object"
}
