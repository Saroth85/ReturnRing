{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "EvidenceQuality": {
      "enum": [
        "sufficient",
        "insufficient"
      ],
      "title": "EvidenceQuality",
      "type": "string"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "A figure shown in the UI: its value, its unit and where it comes from.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "eur",
            "usd",
            "count",
            "expected_count",
            "ratio",
            "probability",
            "percent",
            "percentage_points",
            "z_score",
            "score",
            "days",
            "seconds",
            "milliseconds",
            "tokens_per_second",
            "gib",
            "watts"
          ],
          "title": "Unit",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "value",
        "unit",
        "provenance"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Path": {
      "enum": [
        "withdrawal",
        "guarantee"
      ],
      "title": "Path",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a number comes from: origin, period and nature (same fields as contracts.io).",
      "properties": {
        "origin": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "nature": {
          "enum": [
            "real",
            "synthetic",
            "simulated"
          ],
          "title": "Nature",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "period_start",
        "period_end",
        "nature"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Quadrant": {
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "Q4"
      ],
      "title": "Quadrant",
      "type": "string"
    },
    "QueueItem": {
      "additionalProperties": false,
      "properties": {
        "return_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Return Id",
          "type": "string"
        },
        "order_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Order Id",
          "type": "string"
        },
        "customer_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Customer Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Display Name"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/ReturnReason"
        },
        "path": {
          "$ref": "#/$defs/Path"
        },
        "evidence_quality": {
          "$ref": "#/$defs/EvidenceQuality"
        },
        "quadrant": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quadrant"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Decision Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "proposed",
            "approved",
            "overridden",
            "rejected"
          ],
          "title": "State",
          "type": "string"
        },
        "requires_approval": {
          "title": "Requires Approval",
          "type": "boolean"
        },
        "lever_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 3,
            "type": "string"
          },
          "title": "Lever Ids",
          "type": "array"
        },
        "risk": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_net_benefit": {
          "$ref": "#/$defs/Metric"
        },
        "linked_account_count": {
          "minimum": 0,
          "title": "Linked Account Count",
          "type": "integer"
        },
        "variant_anomaly": {
          "title": "Variant Anomaly",
          "type": "boolean"
        },
        "draft_status": {
          "enum": [
            "ready",
            "pending"
          ],
          "title": "Draft Status",
          "type": "string"
        }
      },
      "required": [
        "return_id",
        "order_id",
        "customer_id",
        "display_name",
        "requested_at",
        "reason",
        "path",
        "evidence_quality",
        "quadrant",
        "decision_id",
        "state",
        "requires_approval",
        "lever_ids",
        "risk",
        "value",
        "expected_net_benefit",
        "linked_account_count",
        "variant_anomaly",
        "draft_status"
      ],
      "title": "QueueItem",
      "type": "object"
    },
    "ReturnReason": {
      "enum": [
        "size",
        "changed_mind",
        "not_as_expected",
        "defective",
        "damaged_in_shipping",
        "wrong_item",
        "not_as_described",
        "other"
      ],
      "title": "ReturnReason",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/QueueItem"
      },
      "title": "Items",
      "type": "array"
    },
    "total": {
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    },
    "page": {
      "minimum": 1,
      "title": "Page",
      "type": "integer"
    },
    "page_size": {
      "maximum": 100,
      "minimum": 1,
      "title": "Page Size",
      "type": "integer"
    },
    "sort": {
      "enum": [
        "-expected_net_benefit",
        "expected_net_benefit",
        "-requested_at",
        "requested_at",
        "-risk"
      ],
      "title": "Sort",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    }
  },
  "required": [
    "items",
    "total",
    "page",
    "page_size",
    "sort",
    "as_of"
  ],
  "title": "QueueResponse",
  "type": "object"
}
