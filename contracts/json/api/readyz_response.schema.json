{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "ClockView": {
      "additionalProperties": false,
      "description": "The one clock of the API (1.5.0, ADR-15 section 15). demo (DEMO_CLOCK=on): 'now' is the\ninstant of the serving snapshot plus the time elapsed since the demo reset started the\nclock, so the deadlines of the decisions the reset made stay ahead; system: the wall clock;\nfixed: a clock that stands still (tests). Every 'now' of the API (as_of, the time of an act,\nthe period of a figure that ends now) is this clock's.\n\nfrozen (1.6.0, ADR-15 section 16): the demo clock of the public read-only demo stands at\nthe snapshot instant (now equals snapshot_as_of), so no refund deadline of the reset's\nproposals passes while the demo stays up; a client never advances a frozen clock. Where\nwrites are on (a cached demo with writes on included) the demo clock runs (1.7.0).",
      "properties": {
        "kind": {
          "enum": [
            "demo",
            "system",
            "fixed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "now": {
          "format": "date-time",
          "title": "Now",
          "type": "string"
        },
        "snapshot_as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Snapshot As Of"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Started At"
        },
        "frozen": {
          "title": "Frozen",
          "type": "boolean"
        },
        "note": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "now",
        "snapshot_as_of",
        "started_at",
        "frozen",
        "note"
      ],
      "title": "ClockView",
      "type": "object"
    },
    "ComponentCheck": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "enum": [
            "database",
            "scores",
            "models",
            "vllm",
            "demo_cache",
            "telemetry"
          ],
          "title": "Component",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "unavailable",
            "disabled"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail"
        }
      },
      "required": [
        "component",
        "status",
        "detail"
      ],
      "title": "ComponentCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "ready",
        "degraded",
        "not_ready"
      ],
      "title": "Status",
      "type": "string"
    },
    "mode": {
      "enum": [
        "live",
        "cached"
      ],
      "title": "Mode",
      "type": "string"
    },
    "llm_mode": {
      "enum": [
        "vllm",
        "mock"
      ],
      "title": "Llm Mode",
      "type": "string"
    },
    "device": {
      "enum": [
        "cpu",
        "gpu"
      ],
      "title": "Device",
      "type": "string"
    },
    "label": {
      "anyOf": [
        {
          "const": "Precomputed on AMD MI300X",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Label"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/ComponentCheck"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "contract_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Contract Version",
      "type": "string"
    },
    "rules_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Rules Version",
      "type": "string"
    },
    "assumptions_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Assumptions Version",
      "type": "string"
    },
    "model_versions": {
      "additionalProperties": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "title": "Model Versions",
      "type": "object"
    },
    "clock": {
      "$ref": "#/$defs/ClockView"
    },
    "public_read_only": {
      "title": "Public Read Only",
      "type": "boolean"
    }
  },
  "required": [
    "status",
    "mode",
    "llm_mode",
    "device",
    "label",
    "checks",
    "contract_version",
    "rules_version",
    "assumptions_version",
    "model_versions",
    "clock",
    "public_read_only"
  ],
  "title": "ReadyzResponse",
  "type": "object"
}
