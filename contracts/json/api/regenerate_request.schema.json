{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "additionalProperties": false,
  "description": "A new draft in other languages or another tone. No free-text instruction: the prompt\nonly takes data (NFR-11). The response is plain JSON, not a stream: the validator checks the\nwhole output before it reaches the UI.",
  "properties": {
    "decision_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Decision Id",
      "type": "string"
    },
    "languages": {
      "items": {
        "enum": [
          "it",
          "en"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Languages",
      "type": "array"
    },
    "tone": {
      "default": "warm",
      "enum": [
        "neutral",
        "warm",
        "formal"
      ],
      "title": "Tone",
      "type": "string"
    },
    "requested_by": {
      "not": {
        "const": "system"
      },
      "pattern": "^[a-z][a-z0-9._-]{1,31}$",
      "title": "Requested By",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "requested_by"
  ],
  "title": "RegenerateRequest",
  "type": "object"
}
