{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "CustomerMessageView": {
      "additionalProperties": false,
      "description": "A customer message: connective text from the LLM (placeholders only), template fields from\ncode, the fixed legal clause appended by code, and the text the customer receives.",
      "properties": {
        "lang": {
          "enum": [
            "it",
            "en"
          ],
          "title": "Lang",
          "type": "string"
        },
        "connective_text": {
          "maxLength": 900,
          "minLength": 1,
          "title": "Connective Text",
          "type": "string"
        },
        "fields": {
          "$ref": "#/$defs/TemplateFields"
        },
        "legal_clause_kind": {
          "anyOf": [
            {
              "enum": [
                "withdrawal",
                "guarantee"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Legal Clause Kind"
        },
        "rendered_text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Rendered Text",
          "type": "string"
        }
      },
      "required": [
        "lang",
        "connective_text",
        "fields",
        "legal_clause_kind",
        "rendered_text"
      ],
      "title": "CustomerMessageView",
      "type": "object"
    },
    "DecisionEchoView": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/Path"
        },
        "quadrant": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quadrant"
            },
            {
              "type": "null"
            }
          ]
        },
        "lever_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 3,
            "type": "string"
          },
          "title": "Lever Ids",
          "type": "array"
        }
      },
      "required": [
        "path",
        "quadrant",
        "lever_ids"
      ],
      "title": "DecisionEchoView",
      "type": "object"
    },
    "DraftView": {
      "additionalProperties": false,
      "description": "The explanation and messages drafted for a decision (US-304, US-305).",
      "properties": {
        "generation": {
          "$ref": "#/$defs/GenerationInfo"
        },
        "tone": {
          "enum": [
            "neutral",
            "warm",
            "formal"
          ],
          "title": "Tone",
          "type": "string"
        },
        "decision_echo": {
          "$ref": "#/$defs/DecisionEchoView"
        },
        "explanation": {
          "items": {
            "$ref": "#/$defs/ExplanationStatement"
          },
          "minItems": 1,
          "title": "Explanation",
          "type": "array"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/CustomerMessageView"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Messages",
          "type": "array"
        }
      },
      "required": [
        "generation",
        "tone",
        "decision_echo",
        "explanation",
        "messages"
      ],
      "title": "DraftView",
      "type": "object"
    },
    "ExplanationStatement": {
      "additionalProperties": false,
      "description": "A statement of the operator explanation: observed data, a score contribution or a\nhypothesis to verify (US-305). A statement whose text has a digit names the entity, the\nmetric, the value and the period it cites, and the value appears in the text.",
      "properties": {
        "label": {
          "enum": [
            "OBSERVED",
            "SCORE",
            "HYPOTHESIS"
          ],
          "title": "Label",
          "type": "string"
        },
        "text": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "entity": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entity"
        },
        "metric": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Metric"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "period": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Period"
        }
      },
      "required": [
        "label",
        "text",
        "entity",
        "metric",
        "value",
        "period"
      ],
      "title": "ExplanationStatement",
      "type": "object"
    },
    "GenerationInfo": {
      "additionalProperties": false,
      "description": "How an LLM output was produced (spec 8.7 validator path, US-901 cached label).",
      "properties": {
        "generation_id": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
          "title": "Generation Id",
          "type": "string"
        },
        "generation_path": {
          "enum": [
            "llm",
            "llm_regenerated",
            "template"
          ],
          "title": "Generation Path",
          "type": "string"
        },
        "llm_mode": {
          "enum": [
            "vllm",
            "mock"
          ],
          "title": "Llm Mode",
          "type": "string"
        },
        "served_from": {
          "enum": [
            "live",
            "cached"
          ],
          "title": "Served From",
          "type": "string"
        },
        "model": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "attempts": {
          "maximum": 2,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "validator_errors": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "title": "Validator Errors",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latency Ms"
        }
      },
      "required": [
        "generation_id",
        "generation_path",
        "llm_mode",
        "served_from",
        "model",
        "attempts",
        "validator_errors",
        "created_at",
        "latency_ms"
      ],
      "title": "GenerationInfo",
      "type": "object"
    },
    "Path": {
      "enum": [
        "withdrawal",
        "guarantee"
      ],
      "title": "Path",
      "type": "string"
    },
    "Quadrant": {
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "Q4"
      ],
      "title": "Quadrant",
      "type": "string"
    },
    "TemplateFields": {
      "additionalProperties": false,
      "description": "Values the code fills into the message placeholders (ADR-08): never written by the LLM.",
      "properties": {
        "terms": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Terms",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount"
        },
        "deadline": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deadline"
        }
      },
      "required": [
        "terms",
        "amount",
        "deadline"
      ],
      "title": "TemplateFields",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "return_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Return Id",
      "type": "string"
    },
    "decision_id": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]*$",
      "title": "Decision Id",
      "type": "string"
    },
    "draft": {
      "$ref": "#/$defs/DraftView"
    }
  },
  "required": [
    "return_id",
    "decision_id",
    "draft"
  ],
  "title": "RegenerateResponse",
  "type": "object"
}
