{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "AssumptionVersion": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "created_by": {
          "pattern": "^[a-z][a-z0-9._-]{1,31}$",
          "title": "Created By",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "note": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "supersedes": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supersedes"
        },
        "baseline": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Baseline",
          "type": "string"
        },
        "net_benefit": {
          "$ref": "#/$defs/NetBenefitView"
        },
        "sensitivity": {
          "items": {
            "$ref": "#/$defs/SensitivityScenario"
          },
          "title": "Sensitivity",
          "type": "array"
        }
      },
      "required": [
        "version",
        "created_by",
        "created_at",
        "note",
        "supersedes",
        "baseline",
        "net_benefit",
        "sensitivity"
      ],
      "title": "AssumptionVersion",
      "type": "object"
    },
    "Assumptions": {
      "additionalProperties": false,
      "description": "An assumption set; basis is policy.simulator's nature: simulated or realized.\n\nOne label, one set of values. A stored version (GET and PUT /api/simulator/assumptions) has\n`based_on` null. Any other set (the alternatives of a case, a week of KPIs, a sensitivity\nscenario) has its own label in `version` and names in `based_on` the stored version whose\nunit costs it uses: the alternatives of a decision version are labelled\n\"<decision_id>/<alternative kind>\", a sensitivity scenario \"<version>/<scenario>\".",
      "properties": {
        "period": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Period",
          "type": "string"
        },
        "logistics_returns_avoided": {
          "minimum": 0,
          "title": "Logistics Returns Avoided",
          "type": "integer"
        },
        "logistics_cost_per_return_eur": {
          "minimum": 0,
          "title": "Logistics Cost Per Return Eur",
          "type": "number"
        },
        "undue_discounts_avoided": {
          "minimum": 0,
          "title": "Undue Discounts Avoided",
          "type": "integer"
        },
        "avg_undue_discount_eur": {
          "minimum": 0,
          "title": "Avg Undue Discount Eur",
          "type": "number"
        },
        "minutes_saved": {
          "minimum": 0,
          "title": "Minutes Saved",
          "type": "number"
        },
        "hourly_cost_eur": {
          "minimum": 0,
          "title": "Hourly Cost Eur",
          "type": "number"
        },
        "incentives_eur": {
          "minimum": 0,
          "title": "Incentives Eur",
          "type": "number"
        },
        "system_cost_eur": {
          "minimum": 0,
          "title": "System Cost Eur",
          "type": "number"
        },
        "error_cost_eur": {
          "minimum": 0,
          "title": "Error Cost Eur",
          "type": "number"
        },
        "abandonment_margin_lost_eur": {
          "minimum": 0,
          "title": "Abandonment Margin Lost Eur",
          "type": "number"
        },
        "incremental_margin_eur": {
          "minimum": 0,
          "title": "Incremental Margin Eur",
          "type": "number"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "basis": {
          "enum": [
            "simulated",
            "realized"
          ],
          "title": "Basis",
          "type": "string"
        },
        "based_on": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Based On"
        }
      },
      "required": [
        "period",
        "logistics_returns_avoided",
        "logistics_cost_per_return_eur",
        "undue_discounts_avoided",
        "avg_undue_discount_eur",
        "minutes_saved",
        "hourly_cost_eur",
        "incentives_eur",
        "system_cost_eur",
        "error_cost_eur",
        "abandonment_margin_lost_eur",
        "incremental_margin_eur",
        "version",
        "basis",
        "based_on"
      ],
      "title": "Assumptions",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "A figure shown in the UI: its value, its unit and where it comes from.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "eur",
            "usd",
            "count",
            "expected_count",
            "ratio",
            "probability",
            "percent",
            "percentage_points",
            "z_score",
            "score",
            "days",
            "seconds",
            "milliseconds",
            "tokens_per_second",
            "gib",
            "watts"
          ],
          "title": "Unit",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "value",
        "unit",
        "provenance"
      ],
      "title": "Metric",
      "type": "object"
    },
    "NetBenefitComponent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "logistics_costs_avoided",
            "undue_discounts_avoided",
            "time_saved_value",
            "incremental_margin",
            "incentives",
            "system_cost",
            "error_cost",
            "abandonment_margin_lost"
          ],
          "title": "Id",
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/Metric"
        }
      },
      "required": [
        "id",
        "amount"
      ],
      "title": "NetBenefitComponent",
      "type": "object"
    },
    "NetBenefitView": {
      "additionalProperties": false,
      "description": "Net benefit with disjoint components, exactly as policy.simulator.net_benefit computes it\nfrom `assumptions` (a validator recomputes it).",
      "properties": {
        "assumptions": {
          "$ref": "#/$defs/Assumptions"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/NetBenefitComponent"
          },
          "title": "Components",
          "type": "array"
        },
        "total": {
          "$ref": "#/$defs/Metric"
        }
      },
      "required": [
        "assumptions",
        "components",
        "total"
      ],
      "title": "NetBenefitView",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a number comes from: origin, period and nature (same fields as contracts.io).",
      "properties": {
        "origin": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "nature": {
          "enum": [
            "real",
            "synthetic",
            "simulated"
          ],
          "title": "Nature",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "period_start",
        "period_end",
        "nature"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SensitivityScenario": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "base",
            "logistics_halved",
            "abandonment_doubled",
            "both"
          ],
          "title": "Id",
          "type": "string"
        },
        "net_benefit": {
          "$ref": "#/$defs/NetBenefitView"
        }
      },
      "required": [
        "id",
        "net_benefit"
      ],
      "title": "SensitivityScenario",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "GET and PUT /api/simulator/assumptions: the current version and the history.",
  "properties": {
    "current": {
      "$ref": "#/$defs/AssumptionVersion"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/AssumptionVersion"
      },
      "minItems": 1,
      "title": "History",
      "type": "array"
    }
  },
  "required": [
    "current",
    "history"
  ],
  "title": "SimulatorAssumptionsResponse",
  "type": "object"
}
