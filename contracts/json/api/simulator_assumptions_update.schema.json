{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "AssumptionInputs": {
      "additionalProperties": false,
      "description": "The inputs of policy.simulator.Assumptions. Every value is non-negative: the simulator\napplies the signs. There is no refund field: the refund owed is never a saving (rule 9).",
      "properties": {
        "period": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Period",
          "type": "string"
        },
        "logistics_returns_avoided": {
          "minimum": 0,
          "title": "Logistics Returns Avoided",
          "type": "integer"
        },
        "logistics_cost_per_return_eur": {
          "minimum": 0,
          "title": "Logistics Cost Per Return Eur",
          "type": "number"
        },
        "undue_discounts_avoided": {
          "minimum": 0,
          "title": "Undue Discounts Avoided",
          "type": "integer"
        },
        "avg_undue_discount_eur": {
          "minimum": 0,
          "title": "Avg Undue Discount Eur",
          "type": "number"
        },
        "minutes_saved": {
          "minimum": 0,
          "title": "Minutes Saved",
          "type": "number"
        },
        "hourly_cost_eur": {
          "minimum": 0,
          "title": "Hourly Cost Eur",
          "type": "number"
        },
        "incentives_eur": {
          "minimum": 0,
          "title": "Incentives Eur",
          "type": "number"
        },
        "system_cost_eur": {
          "minimum": 0,
          "title": "System Cost Eur",
          "type": "number"
        },
        "error_cost_eur": {
          "minimum": 0,
          "title": "Error Cost Eur",
          "type": "number"
        },
        "abandonment_margin_lost_eur": {
          "minimum": 0,
          "title": "Abandonment Margin Lost Eur",
          "type": "number"
        },
        "incremental_margin_eur": {
          "minimum": 0,
          "title": "Incremental Margin Eur",
          "type": "number"
        }
      },
      "required": [
        "period",
        "logistics_returns_avoided",
        "logistics_cost_per_return_eur",
        "undue_discounts_avoided",
        "avg_undue_discount_eur",
        "minutes_saved",
        "hourly_cost_eur",
        "incentives_eur",
        "system_cost_eur",
        "error_cost_eur",
        "abandonment_margin_lost_eur",
        "incremental_margin_eur"
      ],
      "title": "AssumptionInputs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "PUT body: a new version from base_version (409 if base_version is not current).",
  "properties": {
    "base_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Base Version",
      "type": "string"
    },
    "assumptions": {
      "$ref": "#/$defs/AssumptionInputs"
    },
    "note": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Note",
      "type": "string"
    },
    "author": {
      "not": {
        "const": "system"
      },
      "pattern": "^[a-z][a-z0-9._-]{1,31}$",
      "title": "Author",
      "type": "string"
    }
  },
  "required": [
    "base_version",
    "assumptions",
    "note",
    "author"
  ],
  "title": "SimulatorAssumptionsUpdate",
  "type": "object"
}
