{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_api_schemas.py from apps/api/schemas.py: do not edit",
  "$defs": {
    "GpuSample": {
      "additionalProperties": false,
      "properties": {
        "sampled_at": {
          "format": "date-time",
          "title": "Sampled At",
          "type": "string"
        },
        "utilization": {
          "$ref": "#/$defs/Metric"
        },
        "memory_used": {
          "$ref": "#/$defs/Metric"
        },
        "memory_total": {
          "$ref": "#/$defs/Metric"
        },
        "power": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sampled_at",
        "utilization",
        "memory_used",
        "memory_total",
        "power"
      ],
      "title": "GpuSample",
      "type": "object"
    },
    "LlmStats": {
      "additionalProperties": false,
      "properties": {
        "window_s": {
          "minimum": 1,
          "title": "Window S",
          "type": "integer"
        },
        "requests": {
          "$ref": "#/$defs/Metric"
        },
        "latency_p50": {
          "$ref": "#/$defs/Metric"
        },
        "latency_p95": {
          "$ref": "#/$defs/Metric"
        },
        "tokens_per_second": {
          "$ref": "#/$defs/Metric"
        }
      },
      "required": [
        "window_s",
        "requests",
        "latency_p50",
        "latency_p95",
        "tokens_per_second"
      ],
      "title": "LlmStats",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "A figure shown in the UI: its value, its unit and where it comes from.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "eur",
            "usd",
            "count",
            "expected_count",
            "ratio",
            "probability",
            "percent",
            "percentage_points",
            "z_score",
            "score",
            "days",
            "seconds",
            "milliseconds",
            "tokens_per_second",
            "gib",
            "watts"
          ],
          "title": "Unit",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "value",
        "unit",
        "provenance"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a number comes from: origin, period and nature (same fields as contracts.io).",
      "properties": {
        "origin": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Origin",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "nature": {
          "enum": [
            "real",
            "synthetic",
            "simulated"
          ],
          "title": "Nature",
          "type": "string"
        }
      },
      "required": [
        "origin",
        "period_start",
        "period_end",
        "nature"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "GET /api/telemetry, sampled from amd-smi every 5 s (US-905). In cached mode the GPU is off:\ngpu and llm are null and the note says so.",
  "properties": {
    "mode": {
      "enum": [
        "live",
        "cached"
      ],
      "title": "Mode",
      "type": "string"
    },
    "sampled_at": {
      "format": "date-time",
      "title": "Sampled At",
      "type": "string"
    },
    "interval_s": {
      "const": 5,
      "default": 5,
      "title": "Interval S",
      "type": "integer"
    },
    "device": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Device"
    },
    "gpu": {
      "anyOf": [
        {
          "$ref": "#/$defs/GpuSample"
        },
        {
          "type": "null"
        }
      ]
    },
    "gpu_history": {
      "items": {
        "$ref": "#/$defs/GpuSample"
      },
      "title": "Gpu History",
      "type": "array"
    },
    "llm": {
      "anyOf": [
        {
          "$ref": "#/$defs/LlmStats"
        },
        {
          "type": "null"
        }
      ]
    },
    "api_latency_p95": {
      "anyOf": [
        {
          "$ref": "#/$defs/Metric"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Note"
    }
  },
  "required": [
    "mode",
    "sampled_at",
    "interval_s",
    "device",
    "gpu",
    "gpu_history",
    "llm",
    "api_latency_p95",
    "note"
  ],
  "title": "TelemetryResponse",
  "type": "object"
}
