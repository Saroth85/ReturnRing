{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /api/returns/{id}/decision body",
  "type": "object",
  "required": [
    "action",
    "approver"
  ],
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "approve",
        "edit",
        "override"
      ]
    },
    "levers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "message": {
      "type": "object",
      "properties": {
        "lang": {
          "enum": [
            "it",
            "en"
          ]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "override_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "approver": {
      "type": "string",
      "minLength": 1
    }
  },
  "if": {
    "properties": {
      "action": {
        "const": "override"
      }
    }
  },
  "then": {
    "properties": {
      "override_reason": {
        "type": "string",
        "minLength": 3
      }
    },
    "required": [
      "override_reason"
    ]
  }
}
