{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /api/returns/{id}/decision body",
  "type": "object",
  "required": [
    "action",
    "approver"
  ],
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "approve",
        "edit",
        "override"
      ]
    },
    "levers": {
      "type": "array",
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "value",
          "scope"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "return_window_days",
              "free_return_shipping",
              "instant_refund",
              "free_size_exchange",
              "coupons_enabled",
              "cluster_coupons_disabled",
              "transparency_notice",
              "size_advice",
              "priority_size_exchange"
            ]
          },
          "value": {
            "type": [
              "integer",
              "boolean"
            ]
          },
          "scope": {
            "enum": [
              "future_orders",
              "future_orders_cluster",
              "all_orders",
              "current_order",
              "communication"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "return_window_days"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 14
                },
                "scope": {
                  "const": "future_orders"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "free_return_shipping"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean"
                },
                "scope": {
                  "const": "future_orders"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "instant_refund"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean"
                },
                "scope": {
                  "const": "future_orders"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "free_size_exchange"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean",
                  "const": true
                },
                "scope": {
                  "const": "all_orders"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "coupons_enabled"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean"
                },
                "scope": {
                  "const": "future_orders"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "cluster_coupons_disabled"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean"
                },
                "scope": {
                  "const": "future_orders_cluster"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "transparency_notice"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean"
                },
                "scope": {
                  "const": "communication"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "size_advice"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean"
                },
                "scope": {
                  "const": "current_order"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "priority_size_exchange"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean",
                  "const": true
                },
                "scope": {
                  "const": "all_orders"
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "return_window_days"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "free_return_shipping"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "instant_refund"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "free_size_exchange"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "coupons_enabled"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "cluster_coupons_disabled"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "transparency_notice"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "size_advice"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "priority_size_exchange"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    },
    "message": {
      "type": "object",
      "properties": {
        "lang": {
          "enum": [
            "it",
            "en"
          ]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "override_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "approver": {
      "type": "string",
      "minLength": 1
    }
  },
  "if": {
    "properties": {
      "action": {
        "const": "override"
      }
    }
  },
  "then": {
    "properties": {
      "override_reason": {
        "type": "string",
        "minLength": 3
      }
    },
    "required": [
      "override_reason"
    ]
  }
}
