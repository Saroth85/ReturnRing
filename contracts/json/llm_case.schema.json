{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Case sent to Gemma (already decided)",
  "type": "object",
  "required": [
    "case_id",
    "languages",
    "path",
    "evidence_quality",
    "quadrant",
    "levers",
    "risk",
    "value_eur",
    "policy_text"
  ],
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "items": {
        "enum": [
          "it",
          "en"
        ]
      },
      "minItems": 1
    },
    "path": {
      "enum": [
        "withdrawal",
        "guarantee"
      ]
    },
    "evidence_quality": {
      "enum": [
        "sufficient",
        "insufficient"
      ]
    },
    "missing_evidence": {
      "description": "US-307: evidence that is missing, in plain words; required when evidence is insufficient",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "quadrant": {
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "Q4",
        null
      ]
    },
    "levers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "value",
          "scope"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "return_window_days",
              "free_return_shipping",
              "instant_refund",
              "free_size_exchange",
              "coupons_enabled",
              "cluster_coupons_disabled",
              "transparency_notice",
              "size_advice",
              "priority_size_exchange"
            ]
          },
          "value": {
            "type": [
              "integer",
              "boolean"
            ]
          },
          "scope": {
            "enum": [
              "future_orders",
              "future_orders_cluster",
              "all_orders",
              "current_order",
              "communication"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "return_window_days"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 14
                },
                "scope": {
                  "const": "future_orders"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "free_return_shipping"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean"
                },
                "scope": {
                  "const": "future_orders"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "instant_refund"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean"
                },
                "scope": {
                  "const": "future_orders"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "free_size_exchange"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean",
                  "const": true
                },
                "scope": {
                  "const": "all_orders"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "coupons_enabled"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean"
                },
                "scope": {
                  "const": "future_orders"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "cluster_coupons_disabled"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean"
                },
                "scope": {
                  "const": "future_orders_cluster"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "transparency_notice"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean"
                },
                "scope": {
                  "const": "communication"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "size_advice"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean"
                },
                "scope": {
                  "const": "current_order"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "const": "priority_size_exchange"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean",
                  "const": true
                },
                "scope": {
                  "const": "all_orders"
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "return_window_days"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "free_return_shipping"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "instant_refund"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "free_size_exchange"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "coupons_enabled"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "cluster_coupons_disabled"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "transparency_notice"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "size_advice"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "priority_size_exchange"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    },
    "risk": {
      "type": "object",
      "required": [
        "score",
        "top_factors"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "top_factors": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "feature",
              "value",
              "phrase"
            ]
          }
        }
      }
    },
    "value_eur": {
      "type": "number"
    },
    "cluster": {
      "type": [
        "object",
        "null"
      ]
    },
    "policy_text": {
      "type": "string"
    },
    "customer_text": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "evidence_quality"
        ],
        "properties": {
          "evidence_quality": {
            "const": "insufficient"
          }
        }
      },
      "then": {
        "required": [
          "missing_evidence"
        ],
        "properties": {
          "missing_evidence": {
            "minItems": 1
          },
          "quadrant": {
            "const": null
          },
          "levers": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "const": "guarantee"
          }
        }
      },
      "then": {
        "properties": {
          "quadrant": {
            "const": null
          },
          "levers": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
