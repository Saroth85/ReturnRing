{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gemma output, enforced by vLLM guided decoding, contract v2 (ADR-14)",
  "type": "object",
  "required": [
    "decision_echo",
    "operator_explanation",
    "customer_message"
  ],
  "additionalProperties": false,
  "properties": {
    "decision_echo": {
      "type": "object",
      "required": [
        "path",
        "quadrant",
        "lever_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "enum": [
            "withdrawal",
            "guarantee"
          ]
        },
        "quadrant": {
          "enum": [
            "Q1",
            "Q2",
            "Q3",
            "Q4",
            null
          ]
        },
        "lever_ids": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    },
    "operator_explanation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "label",
          "fact_ids",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "enum": [
              "OBSERVED",
              "SCORE",
              "HYPOTHESIS"
            ]
          },
          "fact_ids": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4
            }
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "customer_message": {
      "type": "object",
      "required": [
        "it",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "it": {
          "type": "string",
          "minLength": 1,
          "maxLength": 900
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 900
        }
      }
    }
  }
}
