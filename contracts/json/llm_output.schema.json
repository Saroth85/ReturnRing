{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gemma output, enforced by vLLM guided decoding, contract v2 (ADR-14, phrasebook amendment)",
  "type": "object",
  "required": [
    "decision_echo",
    "operator_explanation",
    "customer_message"
  ],
  "additionalProperties": false,
  "properties": {
    "decision_echo": {
      "type": "object",
      "required": [
        "path",
        "quadrant",
        "lever_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "enum": [
            "withdrawal",
            "guarantee"
          ]
        },
        "quadrant": {
          "enum": [
            "Q1",
            "Q2",
            "Q3",
            "Q4",
            null
          ]
        },
        "lever_ids": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    },
    "operator_explanation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "label",
          "fact_ids",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "enum": [
              "OBSERVED",
              "SCORE",
              "HYPOTHESIS"
            ]
          },
          "fact_ids": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4
            }
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "customer_message": {
      "type": "object",
      "required": [
        "sentence_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "sentence_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "enum": [
              "OPEN_THANKS",
              "OPEN_MESSAGE",
              "OPEN_CHOICE",
              "OPEN_SORRY_FIT",
              "OPEN_SORRY_ITEM",
              "HELP_SIZE",
              "HELP_ADVICE",
              "CONTACT_REPLY",
              "CONTACT_TEAM",
              "INFO_TERMS",
              "GUARANTEE_CARE",
              "GUARANTEE_PHOTO",
              "THANKS_FEEDBACK",
              "CLOSE_REGARDS",
              "CLOSE_VALUED",
              "CLOSE_HAPPY",
              "CLOSE_DAY",
              "CLOSE_SOON",
              "CLOSE_PATIENCE"
            ]
          }
        }
      }
    }
  }
}
